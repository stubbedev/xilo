package views

import (
	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/accordion"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/copybutton"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/progress"
	"github.com/templui/templui/components/separator"
	"github.com/templui/templui/components/table"
	"github.com/templui/templui/components/tabs"
)

type CacheData struct {
	Nav Nav
	// Secret is a just-minted token, rendered into the setup snippets so the
	// reader copies a working command. Empty on every ordinary page view.
	Secret string
	// CanManage gates the token-minting controls (account admins and above).
	CanManage bool
	Cache     store.Cache
	Stats     store.Stats
	Dedup     string
	BaseURL   string
	Host      string
	Bytes     func(int64) string
	Paths     []store.PathInfo
	PathQuery string
	PathTotal int64
	PathPager Pager
	PathSort  SortCtx
	Flash     Flash
}

templ CacheView(d CacheData) {
	@Layout(d.Cache.Ref(), "caches", d.Nav, d.Flash) {
		@Crumbs(Crumb{T("nav.caches"), "/admin"}, Crumb{d.Cache.Ref(), ""})
		@PageHeader(d.Cache.Ref(), d.BaseURL+"/c/"+d.Cache.Ref()) {
			@VisBadge(d.Cache.Public)
		}
		<div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@StatTile("package", Count(d.Stats.Paths), T("kpi.paths"), "", "")
			@StatTile("database", d.Bytes(d.Stats.LogicalBytes), T("kpi.logical"), "", "")
			@StatTile("hard-drive", d.Bytes(d.Stats.PhysicalBytes), T("kpi.physical")+capLabel(d.Cache.MaxBytes, d.Bytes), "", "")
			@StatTile("layers", d.Dedup+"×", T("kpi.dedup"), "", "")
		</div>
		if d.Cache.MaxBytes > 0 {
			<div class="mb-8">
				@progress.Progress(progress.Props{Value: fillPct(d.Stats.PhysicalBytes, d.Cache.MaxBytes), Size: progress.SizeSm, Variant: capVariant(d.Stats.PhysicalBytes, d.Cache.MaxBytes)})
			</div>
		}
		<div class="mb-8 grid gap-6 lg:grid-cols-2">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						{ T("cd.use") }
					}
					@card.Description() {
						{ T("cd.usehint") }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@tabs.Tabs(tabs.Props{ID: "use"}) {
						@tabs.List() {
							@tabs.Trigger(tabs.TriggerProps{Value: "nixconf", IsActive: true}) {
								nix.conf
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "flake"}) {
								flake
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "cli"}) {
								CLI
							}
						}
						@tabs.Content(tabs.ContentProps{Value: "nixconf", IsActive: true}) {
							@snippetBlock(snippetNixConf(d))
						}
						@tabs.Content(tabs.ContentProps{Value: "flake"}) {
							@snippetBlock(snippetFlake(d))
						}
						@tabs.Content(tabs.ContentProps{Value: "cli"}) {
							@snippetBlock(snippetCLI(d))
						}
					}
					if !d.Cache.Public {
						<div class="space-y-2">
							<p class="text-xs text-muted-foreground">{ T("cd.private") }</p>
							<p class="text-sm font-medium">{ T("cd.netrc") }</p>
							@snippetBlock(snippetNetrc(d))
							<p class="text-xs text-muted-foreground">{ T("cd.netrchint") }</p>
						</div>
					}
					if d.CanManage {
						@cacheTokenDialog(d, "dlg-pulltok", T("cd.pulltoken"), false, true)
					}
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						{ T("cd.push") }
					}
					@card.Description() {
						{ T("cd.pushhint") }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@snippetBlock(snippetPush(d))
					if d.CanManage {
						@cacheTokenDialog(d, "dlg-pushtok", T("cd.pushtoken"), true, false)
					}
				}
			}
		</div>
		@SectionHeader(T("cd.paths")) {
			@SearchInput("/admin/cache/"+d.Cache.Ref(), "q", d.PathQuery, T("cd.search"), "#path-results")
		}
		<div class="mb-8">
			@pathResults(d)
		</div>
		@card.Card() {
			@card.Content(card.ContentProps{Class: "py-2"}) {
				@accordion.Accordion() {
					@accordion.Item(accordion.ItemProps{Attributes: templ.Attributes{"open": true}}) {
						@accordion.Trigger() {
							{ T("cd.settings") }
						}
						@accordion.Content() {
							<form method="post" action={ templ.SafeURL("/admin/cache/" + d.Cache.Ref() + "/configure") } class="grid gap-4 sm:grid-cols-3">
								<div class="sm:col-span-3">
									@VisibilitySwitch(!d.Cache.Public)
								</div>
								@PriorityField(d.Cache.Priority)
								@Field("", T("cd.retention")) {
									@DurationInput("retention", d.Cache.Retention)
								}
								@Field("", T("cd.maxsize")) {
									@SizeInput("max", d.Cache.MaxBytes)
								}
								<div class="sm:col-span-3">
									@button.Button(button.Props{Type: button.TypeSubmit}) {
										@Icon("check")
										<span>{ T("cd.save") }</span>
									}
								</div>
							</form>
						}
					}
					@accordion.Item() {
						@accordion.Trigger() {
							{ T("cd.maint") }
						}
						@accordion.Content(accordion.ContentProps{Class: "space-y-4"}) {
							@ActionRow(T("cd.rotatehint")) {
								@ConfirmForm(Confirm{
									ID:           "rotate",
									Action:       "/admin/cache/" + d.Cache.Ref() + "/rotate",
									Title:        T("cd.rotatetitle"),
									Message:      T("confirm.rotate"),
									ConfirmLabel: T("cd.rotate"),
									ConfirmIcon:  "key-round",
									TriggerLabel: T("cd.rotate"),
									TriggerIcon:  "key-round",
								})
							}
							@separator.Separator()
							@ActionRow(T("cd.deletehint")) {
								@ConfirmForm(Confirm{
									ID:           "delete-cache",
									Action:       "/admin/cache/" + d.Cache.Ref() + "/delete",
									Title:        T("cd.deletetitle"),
									Message:      "“" + d.Cache.Ref() + "” " + T("cd.deletemsg"),
									ConfirmLabel: T("cd.delete"),
									ConfirmIcon:  "trash-2",
									Danger:       true,
									TriggerLabel: T("action.delete"),
									TriggerIcon:  "trash-2",
								})
							}
						}
					}
				}
			}
		}
	}
}

// cacheTokenDialog mints a token for this cache. The scope is the page itself,
// so it is shown as a fact rather than asked for — the account and cache a
// token grants can no longer be picked wrong.
templ cacheTokenDialog(d CacheData, id, label string, push, pull bool) {
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@PlusButton(label)
		}
		@DialogBox(label, T("cd.tokenhint"), true) {
			<form method="post" action={ templ.SafeURL("/admin/cache/" + d.Cache.Ref() + "/tokens") } class="mt-2 space-y-4">
				@Field(id+"-name", T("tokens.name")) {
					@input.Input(input.Props{ID: id + "-name", Name: "name", Value: d.Cache.Name, Placeholder: T("ph.tokenname"), Required: true})
				}
				@Field("", T("tokens.scope")) {
					@input.Input(input.Props{ID: id + "-scope", Value: d.Cache.Ref(), Disabled: true})
				}
				@Field("", T("tokens.perms")) {
					<div class="space-y-2">
						@PermSwitchID(id+"-push", "push", "on", T("tokens.push"), push)
						@PermSwitchID(id+"-pull", "pull", "on", T("tokens.pull"), pull)
						@PermSwitchID(id+"-manage", "manage", "on", T("tokens.manage"), false)
					</div>
				}
				@ExpiryField(id, nil)
				@DialogFooter(id, "plus", T("tokens.create"))
			</form>
		}
	}
}

// snippetBlock is a multi-line code snippet with a copy button. Flex, not an
// absolutely placed button: the button never sits on top of long lines.
templ snippetBlock(text string) {
	<div class="flex items-start gap-2 rounded-lg border bg-muted/40 p-2">
		<pre id={ copyID(text) } class="min-w-0 flex-1 overflow-x-auto p-1 font-mono text-xs leading-relaxed scrollbar-none">{ text }</pre>
		@copybutton.CopyButton(copybutton.Props{TargetID: copyID(text), Class: "shrink-0"})
	</div>
}

// pathResults is the swap target for live path search.
templ pathResults(d CacheData) {
	<div id="path-results" hx-target="#path-results" hx-select="#path-results" hx-swap="outerHTML show:none">
		if len(d.Paths) == 0 {
			if d.PathQuery != "" {
				@EmptyState("package-search", T("cd.nomatch"))
			} else {
				@EmptyState("package-search", T("cd.pathsempty"))
			}
		} else {
			@TableCard() {
				@table.Table(table.Props{Class: "table-fixed"}) {
					@table.Header() {
						@table.Row() {
							@SortHead(d.PathSort, "path", T("paths.path"), "")
							@SortHead(d.PathSort, "size", T("paths.size"), "w-32")
							@SortHead(d.PathSort, "pulled", T("paths.pulled"), "w-40")
						}
					}
					@table.Body() {
						for _, p := range d.Paths {
							{{ hash, name := pathParts(p.StorePath) }}
							@table.Row() {
								@table.Cell() {
									<div class="flex min-w-0 items-center gap-2">
										<a href={ templ.SafeURL(pathURL(d.Cache, p.StorePath)) } class="truncate font-medium hover:underline" aria-label={ T("paths.open") }>{ name }</a>
										if hash != "" {
											@WithTooltip(p.StorePath) {
												<code class="font-mono text-xs text-muted-foreground">{ hash }</code>
											}
										}
									</div>
								}
								@table.Cell(table.CellProps{Class: "tabular-nums"}) {
									{ d.Bytes(p.NarSize) }
								}
								@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
									{ Ago(p.Accessed) }
								}
							}
						}
					}
				}
			}
			@PagerNav(d.PathPager)
		}
	</div>
}
