package views

import (
	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/copybutton"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/table"
	"github.com/templui/templui/components/tabs"
)

type CacheData struct {
	Nav Nav
	// Secret is a just-minted token, rendered into the setup snippets so the
	// reader copies a working command. Empty on every ordinary page view.
	Secret string
	// CanManage gates the token-minting controls (account admins and above).
	CanManage bool
	Cache     store.Cache
	Stats     store.Stats
	Dedup     string
	BaseURL   string
	Host      string
	Bytes     func(int64) string
	Paths     []store.PathInfo
	PathQuery string
	PathTotal int64
	PathPager Pager
	PathSort  SortCtx
	Flash     Flash
}

templ CacheView(d CacheData) {
	@Layout(d.Cache.Ref(), "caches", d.Nav, d.Flash) {
		@Crumbs(Crumb{T(ctx, "nav.caches"), "/admin"}, Crumb{d.Cache.Ref(), ""})
		@PageHeaderCode(d.Cache.Ref(), d.BaseURL+"/c/"+d.Cache.Ref()) {
			@VisBadge(d.Cache.Public)
		}
		@DedupBar(d.Stats.LogicalBytes, d.Stats.PhysicalBytes, d.Dedup, d.Bytes)
		@StatRow() {
			@StatTile("package", Count(d.Stats.Paths), T(ctx, "kpi.paths"), "", "")
			@StatTile("hard-drive", d.Bytes(d.Stats.PhysicalBytes), T(ctx, "kpi.physical")+capLabel(ctx, d.Cache.MaxBytes, d.Bytes), "", capTone(d.Stats.PhysicalBytes, d.Cache.MaxBytes))
		}
		<div class="mb-8 grid items-start gap-6 lg:grid-cols-2">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						{ T(ctx, "cd.use") }
					}
					@card.Description() {
						{ T(ctx, "cd.usehint") }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@tabs.Tabs(tabs.Props{ID: "use"}) {
						@tabs.List() {
							@tabs.Trigger(tabs.TriggerProps{Value: "nixconf", IsActive: true}) {
								{ T(ctx, "cd.tab.nixconf") }
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "flake"}) {
								{ T(ctx, "cd.tab.flake") }
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "cli"}) {
								{ T(ctx, "cd.tab.cli") }
							}
						}
						@tabs.Content(tabs.ContentProps{Value: "nixconf", IsActive: true}) {
							@snippetBlock(snippetNixConf(d))
						}
						@tabs.Content(tabs.ContentProps{Value: "flake"}) {
							@snippetBlock(snippetFlake(d))
						}
						@tabs.Content(tabs.ContentProps{Value: "cli"}) {
							@snippetBlock(snippetCLI(d))
						}
					}
					if !d.Cache.Public {
						<div class="space-y-2">
							<p class="text-xs text-muted-foreground">{ T(ctx, "cd.private") }</p>
							<p class="text-sm font-medium">{ T(ctx, "cd.netrc") }</p>
							@snippetBlock(snippetNetrc(d))
							<p class="text-xs text-muted-foreground">{ T(ctx, "cd.netrchint") }</p>
						</div>
					}
					if d.CanManage {
						@cacheTokenDialog(d, "dlg-pulltok", T(ctx, "cd.pulltoken"), false, true)
					}
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						{ T(ctx, "cd.push") }
					}
					@card.Description() {
						{ T(ctx, "cd.pushhint") }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@snippetBlock(snippetPush(d))
					if d.CanManage {
						@cacheTokenDialog(d, "dlg-pushtok", T(ctx, "cd.pushtoken"), true, false)
					}
				}
			}
		</div>
		@SectionHeader(T(ctx, "cd.paths")) {
			// Nothing pushed yet: there is nothing to search through.
			if len(d.Paths) > 0 || d.PathQuery != "" {
				@SearchInput("/admin/cache/"+d.Cache.Ref(), "q", d.PathQuery, T(ctx, "cd.search"), "#path-results")
			}
		}
		<div class="mb-8">
			@pathResults(d)
		</div>
		<div class="grid gap-8">
			@SettingsCard(T(ctx, "cd.settings"), "") {
				<form method="post" action={ templ.SafeURL("/admin/cache/" + d.Cache.Ref() + "/configure") } class="grid gap-4 sm:grid-cols-3">
						<div class="sm:col-span-3">
							@VisibilitySwitch(!d.Cache.Public)
						</div>
						@PriorityField(d.Cache.Priority)
						@Field("", T(ctx, "cd.retention")) {
							@DurationInput("retention", d.Cache.Retention)
						}
						@Field("", T(ctx, "cd.maxsize")) {
							@SizeInput("max", d.Cache.MaxBytes)
						}
						<div class="sm:col-span-3">
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								@Icon("check")
								<span>{ T(ctx, "action.save") }</span>
							}
						</div>
					</form>
			}
			// Maintenance is two sentences and two buttons — a section with
			// rules, not a panel: nothing here is submitted as a whole.
			@ListSection(T(ctx, "cd.maint"), nil) {
				<div class="divide-y border-y">
					<div class="py-3">
						@ActionRow(T(ctx, "cd.rotatehint")) {
							@ConfirmForm(Confirm{
								ID:           "rotate",
								Action:       "/admin/cache/" + d.Cache.Ref() + "/rotate",
								Title:        T(ctx, "cd.rotatetitle"),
								Message:      T(ctx, "confirm.rotate"),
								ConfirmLabel: T(ctx, "cd.rotate"),
								ConfirmIcon:  "key-round",
								TriggerLabel: T(ctx, "cd.rotate"),
								TriggerIcon:  "key-round",
							})
						}
					</div>
					<div class="py-3">
						@ActionRow(T(ctx, "cd.deletehint")) {
							@ConfirmForm(Confirm{
								ID:           "delete-cache",
								Action:       "/admin/cache/" + d.Cache.Ref() + "/delete",
								Title:        T(ctx, "cd.deletetitle"),
								Message:      Tf(ctx, "cd.deletemsg", d.Cache.Ref()),
								ConfirmLabel: T(ctx, "action.delete"),
								ConfirmIcon:  "trash-2",
								Danger:       true,
								TriggerLabel: T(ctx, "action.delete"),
								TriggerIcon:  "trash-2",
							})
						}
					</div>
				</div>
			}
		</div>
	}
}

// cacheTokenDialog mints a token for this cache. The scope is the page itself,
// so it is shown as a fact rather than asked for — the account and cache a
// token grants can no longer be picked wrong.
templ cacheTokenDialog(d CacheData, id, label string, push, pull bool) {
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@PlusButton(label)
		}
		@DialogBox(label, T(ctx, "cd.tokenhint"), true) {
			<form method="post" action={ templ.SafeURL("/admin/cache/" + d.Cache.Ref() + "/tokens") } class="mt-2 space-y-4">
				@Field(id+"-name", T(ctx, "tokens.name")) {
					@input.Input(input.Props{ID: id + "-name", Name: "name", Value: d.Cache.Name, Placeholder: T(ctx, "ph.tokenname"), Required: true})
				}
				@Field("", T(ctx, "tokens.scope")) {
					@input.Input(input.Props{ID: id + "-scope", Value: d.Cache.Ref(), Disabled: true})
				}
				@Field("", T(ctx, "tokens.perms")) {
					<div>
						@PermSwitchID(id+"-push", "push", "on", T(ctx, "tokens.push"), push)
						@PermSwitchID(id+"-pull", "pull", "on", T(ctx, "tokens.pull"), pull)
						@PermSwitchID(id+"-manage", "manage", "on", T(ctx, "tokens.manage"), false)
					</div>
				}
				@ExpiryField(id, nil)
				@DialogFooter(id, "plus", T(ctx, "action.create"))
			</form>
		}
	}
}

// snippetBlock is a multi-line code snippet with a copy button. The button is
// overlaid so it costs the snippet no width; pr-9 keeps the resting text clear
// of it, and its own bg-card surface (one step off the box's muted/40) hides
// long lines that scroll underneath and leaves the ghost hover still visible.
templ snippetBlock(text string) {
	<div class="relative rounded-lg border bg-muted/40 p-2">
		<pre id={ copyID(text) } class="overflow-x-auto p-1 pr-9 font-mono text-xs leading-relaxed scrollbar-none">{ text }</pre>
		<div class="absolute right-2 top-2 rounded-md border bg-card shadow-sm">
			@copybutton.CopyButton(copybutton.Props{TargetID: copyID(text)})
		</div>
	</div>
}

// pathResults is the swap target for live path search.
templ pathResults(d CacheData) {
	<div id="path-results" hx-target="#path-results" hx-select="#path-results" hx-swap="outerHTML show:none">
		if len(d.Paths) == 0 {
			if d.PathQuery != "" {
				@EmptyState("package-search", T(ctx, "empty.nomatch"))
			} else {
				@EmptyState("package-search", T(ctx, "empty.none"))
			}
		} else {
			@TableCard() {
				@table.Table(table.Props{Class: "table-fixed"}) {
					@table.Header() {
						@table.Row() {
							@SortHead(d.PathSort, "path", T(ctx, "paths.path"), "")
							@SortHead(d.PathSort, "size", T(ctx, "paths.size"), "w-28 text-right")
							@SortHead(d.PathSort, "pulled", T(ctx, "paths.pulled"), "w-40")
						}
					}
					@table.Body() {
						for _, p := range d.Paths {
							{{ hash, name := pathParts(p.StorePath) }}
							@table.Row() {
								@table.Cell() {
									<div class="flex min-w-0 items-center gap-2">
										<a href={ templ.SafeURL(pathURL(d.Cache, p.StorePath)) } class="truncate text-sm font-medium hover:underline" aria-label={ T(ctx, "paths.open") }>{ name }</a>
										if hash != "" {
											@WithTooltip(p.StorePath) {
												@StoreHash(hash)
											}
										}
									</div>
								}
								@table.Cell(table.CellProps{Class: "text-right font-mono text-xs tabular-nums"}) {
									{ d.Bytes(p.NarSize) }
								}
								@table.Cell(table.CellProps{Class: "font-mono text-xs text-muted-foreground"}) {
									{ Ago(ctx, p.Accessed) }
								}
							}
						}
					}
				}
			}
			@PagerNav(d.PathPager)
		}
	</div>
}
