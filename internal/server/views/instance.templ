package views

import (
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/form"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/switch"
	"github.com/templui/templui/components/table"
)

// InstanceData is the admin-only settings page: policy, plans, users, orgs.
type InstanceData struct {
	Nav         Nav
	SelfService bool
	AllowRegs   bool
	RequireOK   bool
	Plans       []store.Plan
	Users       []store.User
	Orgs        []OrgInfo // organizations only, never personal accounts
	Flash       Flash
}

// Instance is the general settings page (instance admins).
templ Instance(d InstanceData) {
	@Layout(T(ctx, "nav.settings"), "settings", d.Nav, d.Flash) {
		if d.SelfService {
			@PageHeader(T(ctx, "set.instance"), T(ctx, "inst.subtitle"))
		} else {
			@PageHeader(T(ctx, "set.instance"), T(ctx, "inst.subtitle.single"))
		}
		<div class="grid gap-6">
			if d.SelfService {
				@policyCard(d)
				@plansCard(d.Plans)
			}
			@usersCard(d.Nav.UserName, d.SelfService, d.Users)
			@orgsCard(d.Orgs)
			@maintCard()
		</div>
	}
}

// policyCard is the registration-policy panel (multi-tenant only).
templ policyCard(d InstanceData) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ T(ctx, "inst.policy") }
			}
		}
		@card.Content() {
			<form method="post" action="/admin/settings/instance" class="space-y-3">
				@form.ItemFlex(form.ItemProps{Class: "justify-between border-b py-3 last:border-0"}) {
					@form.Label(form.LabelProps{For: "allow_registrations"}) {
						{ T(ctx, "inst.regs") }
					}
					@switchcomp.Switch(switchcomp.Props{ID: "allow_registrations", Name: "allow_registrations", Value: "on", Checked: d.AllowRegs})
				}
				@form.ItemFlex(form.ItemProps{Class: "justify-between border-b py-3 last:border-0"}) {
					@form.Label(form.LabelProps{For: "require_approval"}) {
						{ T(ctx, "inst.approve") }
					}
					@switchcomp.Switch(switchcomp.Props{ID: "require_approval", Name: "require_approval", Value: "on", Checked: d.RequireOK})
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					@Icon("check")
					<span>{ T(ctx, "action.save") }</span>
				}
			</form>
		}
	}
}

// plansCard lists plans and holds the create-plan dialog. A list is a section
// on the page, not an object in a box — the card wall around a bordered list
// was two frames drawn around the same rows.
templ plansCard(plans []store.Plan) {
	@ListSection(T(ctx, "set.plans"), newPlanDialog()) {
		if len(plans) == 0 {
			@EmptyState("layers", T(ctx, "empty.none")) {
				@dialog.Trigger(dialog.TriggerProps{For: "dlg-plan-new"}) {
					@PlusButton(T(ctx, "action.new"))
				}
			}
		} else {
			@TableCard() {
				@table.Table() {
					@table.Body() {
							for _, p := range plans {
								@table.Row() {
									@table.Cell() {
										<div class="flex flex-wrap items-center gap-2">
											<span class="font-medium">{ p.Name }</span>
											if p.Public {
												@VisBadge(true)
											}
											if p.OrgsAllowed {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ T(ctx, "plan.orgs") }
												}
											}
											<span class="text-xs text-muted-foreground tabular-nums">{ planLimits(ctx, p) }</span>
										</div>
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@RowActions() {
											@editPlanDialog(p)
											@ConfirmForm(Confirm{
												ID:             "plan-" + strconv.FormatInt(p.ID, 10),
												Action:         "/admin/plans/" + strconv.FormatInt(p.ID, 10) + "/delete",
												Title:          T(ctx, "plan.deletetitle"),
												Message:        Tf(ctx, "plan.deletemsg", p.Name),
												ConfirmLabel:   T(ctx, "action.delete"),
												ConfirmIcon:    "trash-2",
												Danger:         true,
												TriggerIcon:    "trash-2",
												IconOnly:       true,
												TriggerTooltip: T(ctx, "action.delete"),
												TriggerVariant: button.VariantGhost,
											})
										}
									}
								}
							}
					}
				}
			}
		}
	}
}

templ newPlanDialog() {
	@dialog.Dialog(dialog.Props{ID: "dlg-plan-new"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-plan-new"}) {
			@PlusButton(T(ctx, "action.new"))
		}
		@DialogBox(T(ctx, "plan.new"), T(ctx, "plan.hint"), true) {
			@planFormBody("/admin/plans", nil, "plus", T(ctx, "action.create"), "dlg-plan-new")
		}
	}
}

// editPlanDialog is a per-row plan edit trigger + dialog.
templ editPlanDialog(p store.Plan) {
	{{ id := "dlg-plan-edit-" + strconv.FormatInt(p.ID, 10) }}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@RowAction("square-pen", T(ctx, "action.edit"), false)
		}
		@DialogBox(T(ctx, "plan.edit"), T(ctx, "plan.hint"), true) {
			@planFormBody("/admin/plans/"+strconv.FormatInt(p.ID, 10)+"/edit", &p, "check", T(ctx, "action.save"), id)
		}
	}
}

// planFormBody is the shared create/edit plan form; p is nil on create.
templ planFormBody(action string, p *store.Plan, submitIcon, submitLabel, dlgID string) {
	<form method="post" action={ templ.SafeURL(action) } class="mt-2 space-y-4">
		@Field(dlgID+"-name", T(ctx, "plan.name")) {
			@input.Input(input.Props{ID: dlgID + "-name", Name: "name", Value: planName(p), Placeholder: T(ctx, "ph.planname"), Required: true})
		}
		<div class="grid gap-4 sm:grid-cols-2">
			@Field(dlgID+"-caches", T(ctx, "plan.maxcaches")) {
				@input.Input(input.Props{ID: dlgID + "-caches", Name: "max_caches", Type: input.TypeNumber, Value: planLimit(p, "caches"), Placeholder: T(ctx, "ph.zerounlimited"), Attributes: templ.Attributes{"min": "0"}})
			}
			@Field(dlgID+"-members", T(ctx, "plan.maxmembers")) {
				@input.Input(input.Props{ID: dlgID + "-members", Name: "max_members", Type: input.TypeNumber, Value: planLimit(p, "members"), Placeholder: T(ctx, "ph.zerounlimited"), Attributes: templ.Attributes{"min": "0"}})
			}
		</div>
		@Field("", T(ctx, "plan.maxstorage")) {
			@SizeInput("plan_storage", planBytes(p))
		}
		@Field("", T(ctx, "plan.maxretention")) {
			@DurationInput("plan_retention", planSecs(p))
		}
		@PermSwitchID(dlgID+"-orgs_allowed", "orgs_allowed", "on", T(ctx, "plan.orgsallowed"), p != nil && p.OrgsAllowed)
		@PermSwitchID(dlgID+"-public", "public", "on", T(ctx, "plan.public"), p == nil || p.Public)
		@DialogFooter(dlgID, submitIcon, submitLabel)
	</form>
}

// usersCard is the user administration block.
templ usersCard(actingName string, multiTenant bool, users []store.User) {
	@ListSection(T(ctx, "set.users"), newUserDialog(multiTenant)) {
		@TableCard() {
			@table.Table() {
				@table.Body() {
					for _, u := range users {
						@table.Row() {
							@table.Cell() {
								<div class="flex flex-wrap items-center gap-2">
									@RoleIcon(userRole(u))
									<span class="font-medium">{ u.Name }</span>
									if u.Email != "" {
										<span class="text-xs text-muted-foreground">{ u.Email }</span>
									}
								</div>
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								@RowActions() {
									if u.Status == "pending" {
										<form method="post" action={ templ.SafeURL("/admin/users/" + strconv.FormatInt(u.ID, 10) + "/approve") }>
											@RowAction("user-check", T(ctx, "users.approve"), true)
										</form>
									}
									@resetUserDialog(u)
									if u.Name != actingName && u.Role != "owner" {
										@ConfirmForm(Confirm{
											ID:             "del-user-" + strconv.FormatInt(u.ID, 10),
											Action:         "/admin/users/" + strconv.FormatInt(u.ID, 10) + "/delete",
											Title:          T(ctx, "users.deletetitle"),
											Message:        Tf(ctx, "users.deletemsg", u.Name),
											ConfirmLabel:   T(ctx, "action.delete"),
											ConfirmIcon:    "trash-2",
											Danger:         true,
											TriggerIcon:    "trash-2",
											IconOnly:       true,
											TriggerTooltip: T(ctx, "action.delete"),
											TriggerVariant: button.VariantGhost,
										})
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ resetUserDialog(u store.User) {
	{{ id := "dlg-user-reset-" + strconv.FormatInt(u.ID, 10) }}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@RowAction("key-round", T(ctx, "users.reset"), false)
		}
		@DialogBox(Tf(ctx, "users.resetfor", u.Name), T(ctx, "users.resethint"), false) {
			<form method="post" action={ templ.SafeURL("/admin/users/" + strconv.FormatInt(u.ID, 10) + "/reset") } class="mt-2 space-y-4">
				@Field("reset-pw-"+strconv.FormatInt(u.ID, 10), T(ctx, "users.newpw")) {
					@input.Input(input.Props{ID: "reset-pw-" + strconv.FormatInt(u.ID, 10), Name: "password", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "8"}})
				}
				@DialogFooter(id, "key-round", T(ctx, "action.reset"))
			</form>
		}
	}
}

templ newUserDialog(multiTenant bool) {
	@dialog.Dialog(dialog.Props{ID: "dlg-user-new"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-user-new"}) {
			@PlusButton(T(ctx, "action.new"))
		}
		@DialogBox(T(ctx, "users.new"), T(ctx, "users.hint"), false) {
			<form method="post" action="/admin/users" class="mt-2 space-y-4">
				@Field("nu-name", T(ctx, "users.name")) {
					@input.Input(input.Props{ID: "nu-name", Name: "username", Placeholder: T(ctx, "ph.newuser"), Required: true, Attributes: templ.Attributes{"pattern": "[-a-z0-9_]+"}})
				}
				@Field("nu-email", T(ctx, "users.email")) {
					@input.Input(input.Props{ID: "nu-email", Name: "email", Type: input.TypeEmail, Placeholder: T(ctx, "ph.newemail"), Required: multiTenant})
				}
				@Field("nu-pw", T(ctx, "login.password")) {
					@input.Input(input.Props{ID: "nu-pw", Name: "password", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "8"}})
				}
				@DialogFooter("dlg-user-new", "plus", T(ctx, "action.create"))
			</form>
		}
	}
}

// orgsCard lists organizations with usage and holds the create-org dialog.
templ orgsCard(orgs []OrgInfo) {
	@ListSection(T(ctx, "org.title"), newOrgDialog("/admin/orgs")) {
		if len(orgs) == 0 {
			@EmptyState("building-2", T(ctx, "empty.none")) {
				@dialog.Trigger(dialog.TriggerProps{For: "dlg-org-new"}) {
					@PlusButton(T(ctx, "action.new"))
				}
			}
		} else {
			@TableCard() {
				@table.Table() {
					@table.Body() {
						for _, info := range orgs {
							@table.Row() {
								@table.Cell() {
									<div class="flex items-center gap-2">
										@Icon("building-2")
										<a href={ templ.SafeURL("/admin/org/" + info.Account.Slug) } class="font-medium hover:underline">{ info.Account.Slug }</a>
										@Meta() {
											{ UsagePhrase(ctx, info) }
										}
									</div>
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									@ConfirmForm(Confirm{
										ID:             "org-" + info.Account.Slug,
										Action:         "/admin/org/" + info.Account.Slug + "/delete",
										Title:          T(ctx, "org.deletetitle"),
										Message:        Tf(ctx, "org.deletemsg", info.Account.Slug),
										ConfirmLabel:   T(ctx, "action.delete"),
										ConfirmIcon:    "trash-2",
										Danger:         true,
										TriggerIcon:    "trash-2",
										IconOnly:       true,
										TriggerTooltip: T(ctx, "action.delete"),
										TriggerVariant: button.VariantGhost,
									})
								}
							}
						}
					}
				}
			}
		}
	}
}

templ newOrgDialog(action string) {
	@dialog.Dialog(dialog.Props{ID: "dlg-org-new"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-org-new"}) {
			@PlusButton(T(ctx, "action.new"))
		}
		@DialogBox(T(ctx, "org.new"), T(ctx, "org.newhint"), false) {
			<form method="post" action={ templ.SafeURL(action) } class="mt-2 space-y-4">
				@Field("org-name", T(ctx, "org.name")) {
					@input.Input(input.Props{ID: "org-name", Name: "name", Placeholder: T(ctx, "ph.orgname"), Required: true, Attributes: templ.Attributes{"pattern": "[-a-z0-9_]+"}})
				}
				@DialogFooter("dlg-org-new", "plus", T(ctx, "action.create"))
			</form>
		}
	}
}

// maintCard is instance-wide maintenance: garbage collection.
templ maintCard() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ T(ctx, "inst.maint") }
			}
		}
		@card.Content() {
			@ActionRow(T(ctx, "inst.gcdesc")) {
				@ConfirmForm(Confirm{
					ID:           "gc",
					Action:       "/admin/gc",
					Title:        T(ctx, "inst.gctitle"),
					Message:      T(ctx, "inst.gcmsg"),
					ConfirmLabel: T(ctx, "inst.gcrun"),
					ConfirmIcon:  "recycle",
					Danger:       true,
					TriggerLabel: T(ctx, "inst.gcrun"),
					TriggerIcon:  "recycle",
				})
			}
		}
	}
}
