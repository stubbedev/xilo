package views

import (
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/table"
)

// InstanceData is the admin-only settings page: policy, plans, users, orgs.
type InstanceData struct {
	Nav         Nav
	SelfService bool
	AllowRegs   bool
	RequireOK   bool
	Plans       []store.Plan
	Users       []store.User
	// Instance rules — the ceilings and defaults the sysadmin sets for
	// everyone. Zero means the instance imposes nothing.
	InstanceCap    int64 // bytes across every cache
	DefaultRetain  int64 // seconds a new cache keeps a path
	MaxTokenTTL    int64 // seconds, the longest a token may live
	DefaultPlan    int64 // the plan a signup with no choice lands on
	Flash          Flash
}

// Instance is the general settings page (instance admins).
templ Instance(d InstanceData) {
	@Layout(T(ctx, "nav.settings"), "settings", d.Nav, d.Flash) {
		if d.SelfService {
			@PageHeader(T(ctx, "set.instance"), T(ctx, "inst.subtitle"))
		} else {
			@PageHeader(T(ctx, "set.instance"), T(ctx, "inst.subtitle.single"))
		}
		<div class="grid gap-8">
			if d.SelfService {
				@policySection(d)
			}
			@rulesSection(d)
			if d.SelfService {
				@plansCard(d.Plans)
			}
			@usersCard(d.Nav.UserName, d.SelfService, d.Users)
			@maintCard()
		</div>
	}
}

// policySection is the registration policy (multi-tenant only): two switches
// that save the moment they are flipped, the way the account page's appearance
// controls do. Nothing here is filled in, so nothing here is a card with a Save
// button — it is a ruled section like the rest of the page.
templ policySection(d InstanceData) {
	@ListSection(T(ctx, "inst.policy"), nil) {
		<form method="post" action="/admin/settings/instance" class="border-y" onchange="this.requestSubmit()">
			@PermSwitchID("allow_registrations", "allow_registrations", "on", T(ctx, "inst.regs"), d.AllowRegs)
			@PermSwitchID("require_approval", "require_approval", "on", T(ctx, "inst.approve"), d.RequireOK)
		</form>
	}
}

// rulesSection is what a sysadmin sets for everyone: ceilings and defaults
// that apply wherever they are relevant rather than at boot, so changing one
// needs no restart. Every field here has one enforcement site — see rules.go —
// and every field empty means the instance imposes nothing, which is what a
// hobbyist's instance looks like.
templ rulesSection(d InstanceData) {
	@ListSection(T(ctx, "rules.title"), nil) {
		<form method="post" action="/admin/settings/rules" class="space-y-4 border-y py-4">
			<div class="grid items-start gap-4 sm:grid-cols-2 xl:grid-cols-4">
				@FieldInfo("", T(ctx, "rules.cap"), T(ctx, "rules.caphint")) {
					@SizeInput("instance_cap", d.InstanceCap)
				}
				@FieldInfo("", T(ctx, "rules.retention"), T(ctx, "rules.retentionhint")) {
					@DurationInput("default_retention", d.DefaultRetain)
				}
				@FieldInfo("", T(ctx, "rules.tokenttl"), T(ctx, "rules.tokenttlhint")) {
					@DurationInput("max_token_ttl", d.MaxTokenTTL)
				}
				if d.SelfService {
					@FieldInfo("", T(ctx, "rules.defaultplan"), T(ctx, "rules.defaultplanhint")) {
						@planSelect(d.Plans, d.DefaultPlan)
					}
				}
			</div>
			<div class="flex justify-end">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					@Icon("check")
					<span>{ T(ctx, "action.save") }</span>
				}
			</div>
		</form>
	}
}

// intervalSelect is the billing period a priced plan renews on.
templ intervalSelect(selected string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "interval", Attributes: templ.Attributes{"aria-label": T(ctx, "plan.interval")}}) {
			@selectbox.Value(selectbox.ValueProps{})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			@selectbox.Item(selectbox.ItemProps{Value: "month", Selected: selected != "year"}) {
				{ T(ctx, "plan.monthly") }
			}
			@selectbox.Item(selectbox.ItemProps{Value: "year", Selected: selected == "year"}) {
				{ T(ctx, "plan.yearly") }
			}
		}
	}
}

// planSelect picks the signup default; "none" leaves signups choosing.
templ planSelect(plans []store.Plan, selected int64) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "default_plan", Attributes: templ.Attributes{"aria-label": T(ctx, "rules.defaultplan")}}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: T(ctx, "rules.noplan")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: noSearch(len(plans) + 1)}) {
			@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: selected == 0}) {
				{ T(ctx, "rules.noplan") }
			}
			for _, p := range plans {
				@selectbox.Item(selectbox.ItemProps{Value: itoa(p.ID), Selected: p.ID == selected}) {
					{ p.Name }
				}
			}
		}
	}
}

// plansCard lists plans and holds the create-plan dialog. A list is a section
// on the page, not an object in a box — the card wall around a bordered list
// was two frames drawn around the same rows.
templ plansCard(plans []store.Plan) {
	// With no plans yet the empty state carries the only create button — and
	// therefore the dialog too, since the header's copy is not rendered.
	@ListSection(T(ctx, "set.plans"), sectionAction(len(plans) > 0, newPlanDialog())) {
		if len(plans) == 0 {
			@EmptyState("layers", T(ctx, "empty.none")) {
				@newPlanDialog()
			}
		} else {
			@TableCard() {
				@table.Table() {
					@table.Body() {
							for _, p := range plans {
								@table.Row() {
									@table.Cell() {
										<div class="flex flex-wrap items-center gap-2">
											<span class="font-medium">{ p.Name }</span>
											if p.Public {
												@VisBadge(true)
											}
											if p.OrgsAllowed {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ T(ctx, "plan.orgs") }
												}
											}
											<span class="font-mono text-xs tabular-nums">{ PlanPriceLabel(ctx, p) }</span>
											<span class="text-xs text-muted-foreground tabular-nums">{ planLimits(ctx, p) }</span>
										</div>
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@RowActions() {
											@editPlanDialog(p)
											@ConfirmForm(Confirm{
												ID:             "plan-" + strconv.FormatInt(p.ID, 10),
												Action:         "/admin/plans/" + strconv.FormatInt(p.ID, 10) + "/delete",
												Title:          T(ctx, "plan.deletetitle"),
												Message:        Tf(ctx, "plan.deletemsg", p.Name),
												ConfirmLabel:   T(ctx, "action.delete"),
												ConfirmIcon:    "trash-2",
												Danger:         true,
												TriggerIcon:    "trash-2",
												IconOnly:       true,
												TriggerTooltip: T(ctx, "action.delete"),
												TriggerVariant: button.VariantGhost,
											})
										}
									}
								}
							}
					}
				}
			}
		}
	}
}

templ newPlanDialog() {
	@dialog.Dialog(dialog.Props{ID: "dlg-plan-new"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-plan-new"}) {
			@PlusButton(T(ctx, "action.new"))
		}
		@DialogBox(T(ctx, "plan.new"), T(ctx, "plan.hint"), true) {
			@planFormBody("/admin/plans", nil, "plus", T(ctx, "action.create"), "dlg-plan-new")
		}
	}
}

// editPlanDialog is a per-row plan edit trigger + dialog.
templ editPlanDialog(p store.Plan) {
	{{ id := "dlg-plan-edit-" + strconv.FormatInt(p.ID, 10) }}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@RowAction("square-pen", T(ctx, "action.edit"), false)
		}
		@DialogBox(T(ctx, "plan.edit"), T(ctx, "plan.hint"), true) {
			@planFormBody("/admin/plans/"+strconv.FormatInt(p.ID, 10)+"/edit", &p, "check", T(ctx, "action.save"), id)
		}
	}
}

// planFormBody is the shared create/edit plan form; p is nil on create.
templ planFormBody(action string, p *store.Plan, submitIcon, submitLabel, dlgID string) {
	<form method="post" action={ templ.SafeURL(action) } class="mt-2 space-y-4">
		@Field(dlgID+"-name", T(ctx, "plan.name")) {
			@input.Input(input.Props{ID: dlgID + "-name", Name: "name", Value: planName(p), Placeholder: T(ctx, "ph.planname"), Required: true, Attributes: templ.Attributes{"autocomplete": "off"}})
		}
		<div class="grid gap-4 sm:grid-cols-2">
			@Field(dlgID+"-caches", T(ctx, "plan.maxcaches")) {
				@input.Input(input.Props{ID: dlgID + "-caches", Name: "max_caches", Type: input.TypeNumber, Value: planLimit(p, "caches"), Placeholder: T(ctx, "ph.zerounlimited"), Attributes: templ.Attributes{"min": "0", "autocomplete": "off"}})
			}
			@Field(dlgID+"-members", T(ctx, "plan.maxmembers")) {
				@input.Input(input.Props{ID: dlgID + "-members", Name: "max_members", Type: input.TypeNumber, Value: planLimit(p, "members"), Placeholder: T(ctx, "ph.zerounlimited"), Attributes: templ.Attributes{"min": "0", "autocomplete": "off"}})
			}
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			@FieldInfo(dlgID+"-price", T(ctx, "plan.price"), T(ctx, "plan.pricehint")) {
				@input.Input(input.Props{
					ID: dlgID + "-price", Name: "price", Value: planPrice(p),
					Placeholder: T(ctx, "plan.free"),
					Attributes:  templ.Attributes{"inputmode": "decimal", "autocomplete": "off"},
				})
			}
			@Field("", T(ctx, "plan.interval")) {
				@intervalSelect(planInterval(p))
			}
		</div>
		@FieldInfo(dlgID+"-external", T(ctx, "plan.external"), T(ctx, "plan.externalhint")) {
			@input.Input(input.Props{
				ID: dlgID + "-external", Name: "external_id", Value: planExternal(p),
				Placeholder: T(ctx, "plan.externalph"), Attributes: templ.Attributes{"autocomplete": "off"},
			})
		}
		@Field("", T(ctx, "plan.maxstorage")) {
			@SizeInput("plan_storage", planBytes(p))
		}
		@Field("", T(ctx, "plan.maxretention")) {
			@DurationInput("plan_retention", planSecs(p))
		}
		@SwitchGroup() {
			@PermSwitchID(dlgID+"-orgs_allowed", "orgs_allowed", "on", T(ctx, "plan.orgsallowed"), p != nil && p.OrgsAllowed)
			@PermSwitchID(dlgID+"-public", "public", "on", T(ctx, "plan.public"), p == nil || p.Public)
		}
		@DialogFooter(dlgID, submitIcon, submitLabel)
	</form>
}

// usersCard is the user administration block.
templ usersCard(actingName string, multiTenant bool, users []store.User) {
	@ListSection(T(ctx, "set.users"), newUserDialog(multiTenant)) {
		@TableCard() {
			@table.Table() {
				@table.Body() {
					for _, u := range users {
						@table.Row() {
							@table.Cell() {
								<div class="flex flex-wrap items-center gap-2">
									@RoleIcon(userRole(u))
									<span class="font-medium">{ u.Name }</span>
									if u.Email != "" {
										<span class="text-xs text-muted-foreground">{ u.Email }</span>
									}
								</div>
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								@RowActions() {
									if u.Status == "pending" {
										<form method="post" action={ templ.SafeURL("/admin/users/" + strconv.FormatInt(u.ID, 10) + "/approve") }>
											@RowAction("user-check", T(ctx, "users.approve"), true)
										</form>
									}
									@resetUserDialog(u)
									if u.Name != actingName && !u.Superadmin() {
										@ConfirmForm(Confirm{
											ID:             "del-user-" + strconv.FormatInt(u.ID, 10),
											Action:         "/admin/users/" + strconv.FormatInt(u.ID, 10) + "/delete",
											Title:          T(ctx, "users.deletetitle"),
											Message:        Tf(ctx, "users.deletemsg", u.Name),
											ConfirmLabel:   T(ctx, "action.delete"),
											ConfirmIcon:    "trash-2",
											Danger:         true,
											TriggerIcon:    "trash-2",
											IconOnly:       true,
											TriggerTooltip: T(ctx, "action.delete"),
											TriggerVariant: button.VariantGhost,
										})
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ resetUserDialog(u store.User) {
	{{ id := "dlg-user-reset-" + strconv.FormatInt(u.ID, 10) }}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Trigger(dialog.TriggerProps{For: id}) {
			@RowAction("key-round", T(ctx, "users.reset"), false)
		}
		@DialogBox(Tf(ctx, "users.resetfor", u.Name), T(ctx, "users.resethint"), false) {
			<form method="post" action={ templ.SafeURL("/admin/users/" + strconv.FormatInt(u.ID, 10) + "/reset") } class="mt-2 space-y-4">
				@Field("reset-pw-"+strconv.FormatInt(u.ID, 10), T(ctx, "users.newpw")) {
					@input.Input(input.Props{ID: "reset-pw-" + strconv.FormatInt(u.ID, 10), Name: "password", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "off", "minlength": "8"}})
				}
				@DialogFooter(id, "key-round", T(ctx, "action.reset"))
			</form>
		}
	}
}

templ newUserDialog(multiTenant bool) {
	@dialog.Dialog(dialog.Props{ID: "dlg-user-new"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-user-new"}) {
			@PlusButton(T(ctx, "action.new"))
		}
		@DialogBox(T(ctx, "users.new"), T(ctx, "users.hint"), false) {
			<form method="post" action="/admin/users" class="mt-2 space-y-4">
				@Field("nu-name", T(ctx, "users.name")) {
					@input.Input(input.Props{ID: "nu-name", Name: "username", Placeholder: T(ctx, "ph.newuser"), Required: true, Attributes: templ.Attributes{"pattern": "[-a-z0-9_]+", "autocomplete": "off"}})
				}
				@Field("nu-email", T(ctx, "users.email")) {
					@input.Input(input.Props{ID: "nu-email", Name: "email", Type: input.TypeEmail, Placeholder: T(ctx, "ph.newemail"), Required: multiTenant, Attributes: templ.Attributes{"autocomplete": "off"}})
				}
				@Field("nu-pw", T(ctx, "login.password")) {
					@input.Input(input.Props{ID: "nu-pw", Name: "password", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "off", "minlength": "8"}})
				}
				@DialogFooter("dlg-user-new", "plus", T(ctx, "action.create"))
			</form>
		}
	}
}

// maintCard is instance-wide maintenance: garbage collection. A section, not
// a card — one sentence and one button is not an object worth a box.
templ maintCard() {
	@ListSection(T(ctx, "inst.maint"), nil) {
		<div class="border-y py-3">
			@ActionRow(T(ctx, "inst.gcdesc")) {
				@ConfirmForm(Confirm{
					ID:           "gc",
					Action:       "/admin/gc",
					Title:        T(ctx, "inst.gctitle"),
					Message:      T(ctx, "inst.gcmsg"),
					ConfirmLabel: T(ctx, "inst.gcrun"),
					ConfirmIcon:  "recycle",
					Danger:       true,
					TriggerLabel: T(ctx, "inst.gcrun"),
					TriggerIcon:  "recycle",
				})
			}
		</div>
	}
}
