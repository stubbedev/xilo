package views

import (
	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/table"
)

// AuditData is everything the activity page renders.
type AuditData struct {
	Nav     Nav
	Entries []store.AuditEntry
	Query   string
	Method  string // active method filter ("" = all)
	Status  string // active status-class filter ("" = all)
	Methods []string
	Classes []string
	Stats   store.AuditStats
	Total   int64
	Pager   Pager
	Sort    SortCtx
}

// filtered reports whether any narrowing (search or chip) is active.
func (d AuditData) filtered() bool { return d.Query != "" || d.Method != "" || d.Status != "" }

templ AuditPage(d AuditData) {
	@Layout(T(ctx, "audit.title"), "audit", d.Nav, Flash{}) {
		@PageHeader(T(ctx, "audit.title"), T(ctx, "audit.subtitle")) {
			@SearchInput(d.Sort.With("q", ""), "q", d.Query, T(ctx, "audit.search"), "#audit-results")
		}
		<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
			@StatTile("scroll-text", Count(d.Stats.Total), T(ctx, "audit.total"), "", "")
			@StatTile("triangle-alert", Count(d.Stats.Failed), T(ctx, "audit.failed"), "", failTone(d.Stats.Failed))
			@StatTile("users", Count(d.Stats.Actors), T(ctx, "audit.actors"), "", "")
			@StatTile("timer", itoa(d.Stats.AvgMs)+" "+T(ctx, "audit.ms"), T(ctx, "audit.avgms"), "", "")
		</div>
		@auditResults(d)
	}
}

// auditResults is the swap target for live activity search; the filter chips
// live inside it so their active state follows every swap.
templ auditResults(d AuditData) {
	<div id="audit-results" hx-target="#audit-results" hx-select="#audit-results" hx-swap="outerHTML show:none">
		<div class="mb-4 flex flex-wrap items-center gap-x-6 gap-y-2">
			@auditChips(d, "method", T(ctx, "audit.method"), d.Method, d.Methods)
			@auditChips(d, "status", T(ctx, "audit.status"), d.Status, d.Classes)
		</div>
		if len(d.Entries) == 0 {
			if d.filtered() {
				@EmptyState("search-x", T(ctx, "empty.nomatch"))
			} else {
				@EmptyState("scroll-text", T(ctx, "empty.none"))
			}
		} else {
			@TableCard() {
				@table.Table(table.Props{Class: "table-fixed"}) {
					@table.Header() {
						@table.Row() {
							@SortHead(d.Sort, "time", T(ctx, "audit.time"), "w-40")
							@SortHead(d.Sort, "actor", T(ctx, "audit.actor"), "w-44")
							@SortHead(d.Sort, "path", T(ctx, "audit.action"), "")
							@SortHead(d.Sort, "status", T(ctx, "audit.status"), "w-28")
						}
					}
					@table.Body() {
						for _, e := range d.Entries {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
									@WithTooltip(Ago(ctx, e.TS)) {
										<span class="tabular-nums">{ stamp(e.TS) }</span>
									}
								}
								@table.Cell() {
									<div class="min-w-0">
										if e.Actor != "" && e.UserID == 0 {
											@WithTooltip(T(ctx, "audit.token")) {
												<div class="flex items-center gap-1 truncate font-medium">
													@Icon("key-round")
													<span class="truncate">{ e.Actor }</span>
												</div>
											}
										} else if e.Actor != "" {
											<div class="truncate font-medium">{ e.Actor }</div>
										} else {
											<div class="truncate text-muted-foreground">{ T(ctx, "audit.system") }</div>
										}
										if e.IP != "" {
											<div class="truncate font-mono text-xs text-muted-foreground">{ e.IP }</div>
										}
									</div>
								}
								@table.Cell() {
									@auditAction(e)
								}
								@table.Cell() {
									<div class="flex items-center gap-2">
										@badge.Badge(badge.Props{Variant: auditStatusVariant(e.Status)}) {
											{ itoa(int64(e.Status)) }
										}
										<span class="text-xs text-muted-foreground tabular-nums">{ itoa(e.DurationMs) } { T(ctx, "audit.ms") }</span>
									</div>
								}
							}
						}
					}
				}
			}
			@PagerNav(d.Pager)
		}
	</div>
}

// auditChips is one segmented filter: "All" plus one chip per value, each a
// link that swaps the results in place and composes with search and sort.
templ auditChips(d AuditData, param, label, active string, values []string) {
	<div class="flex flex-wrap items-center gap-1">
		<span class="mr-1 text-xs text-muted-foreground">{ label }</span>
		@auditChip(d, param, "", T(ctx, "audit.all"), active == "")
		for _, v := range values {
			@auditChip(d, param, v, v, active == v)
		}
	</div>
}

templ auditChip(d AuditData, param, value, label string, on bool) {
	{{ href := d.Sort.With(param, value) }}
	@button.Button(button.Props{Href: href, Size: button.SizeSm, Variant: chipVariant(on), Class: "h-7 px-2 font-mono text-xs", Attributes: hxSwapAttrs(href, "#audit-results")}) {
		{ label }
	}
}

// auditAction is the method badge + request path; the user agent (when known)
// rides along as a tooltip so it stays observable without widening the table.
templ auditAction(e store.AuditEntry) {
	if e.UserAgent != "" {
		@WithTooltip(e.UserAgent) {
			@auditActionInner(e)
		}
	} else {
		@auditActionInner(e)
	}
}

templ auditActionInner(e store.AuditEntry) {
	<div class="flex min-w-0 items-center gap-2">
		@badge.Badge(badge.Props{Variant: auditMethodVariant(e.Method), Class: "shrink-0 font-mono"}) {
			{ e.Method }
		}
		<span class="truncate font-mono text-sm">{ e.Path }</span>
	</div>
}
