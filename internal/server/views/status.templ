package views

import (
	"fmt"
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/calendar"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/chart"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/sheet"
)

// StatusData is the status page view model. The page is fully server-rendered
// per window; a reload timer keeps it fresh.
type StatusData struct {
	Nav       Nav
	Healthy   bool
	Uptime    string
	HitPct    string
	Updated   string // wall clock of this render
	Rate      int    // reload interval in seconds (server-validated)
	Window    int    // chart window in minutes (server-validated; 0 = custom)
	From, To  string // custom range dates (empty on presets)
	Global    store.Global
	AuthFails int64
	NarServed int64 // NAR downloads since start
	Requests  int64 // HTTP requests since start
	// Push side: what pushers sent, and what the server managed not to store.
	PathsPushed  int64
	PathsAdopted int64 // registered by copying an identical path (no upload)
	ChunksRecv   int64
	ChunksDedup  int64 // uploads that were already present
	Bytes        func(int64) string
	Charts       []ChartData
}

// ChartData is one chart: header strings plus the drawn series. Color must be
// a literal CSS color (canvas can't resolve var()/color-mix in dataset colors).
type ChartData struct {
	ID        string
	Label     string
	Cur, Peak string
	Points    []float64
	Labels    []string
	Color     string
}

var statusRates = []int{2, 5, 10, 30, 60}

// windowURL swaps the window preset, keeping the reload rate.
func windowURL(d StatusData, win int) string {
	return fmt.Sprintf("/admin/status?window=%d&rate=%d", win, d.Rate)
}

// rateURL swaps the reload rate, keeping the window or custom range.
func rateURL(d StatusData, rate int) string {
	if d.Window == 0 {
		return fmt.Sprintf("/admin/status?from=%s&to=%s&rate=%d", d.From, d.To, rate)
	}
	return fmt.Sprintf("/admin/status?window=%d&rate=%d", d.Window, rate)
}

// dataURL is the JSON poll endpoint for the current range.
func dataURL(d StatusData) string {
	if d.Window == 0 {
		return fmt.Sprintf("/admin/status/data?from=%s&to=%s", d.From, d.To)
	}
	return fmt.Sprintf("/admin/status/data?window=%d", d.Window)
}

var statusWindows = []struct {
	Min   int
	Label string
}{{10, "10m"}, {30, "30m"}, {60, "1h"}, {180, "3h"}, {720, "12h"}, {1440, "24h"}, {10080, "7d"}, {43200, "30d"}}

templ StatusPage(d StatusData) {
	@Layout(T(ctx, "status.title"), "status", d.Nav, Flash{}) {
		@PageHeader(T(ctx, "status.title"), T(ctx, "status.subtitle")) {
			@statusSettings(d)
		}
		// Twelve equal tiles asked the reader to rank twelve numbers themselves.
		// The page answers one question first — is it up — so health, uptime and
		// hit rate lead, the live charts come next, and the counters settle
		// underneath as a readout you consult rather than scan.
		<div class="mb-8 flex flex-wrap items-baseline gap-x-10 gap-y-3 border-y py-4">
			<div class="flex items-baseline gap-2.5">
				<span
					id="st-health"
					class={ "font-mono text-3xl font-medium leading-none tracking-tight", healthTone(d.Healthy) }
				>
					if d.Healthy {
						{ T(ctx, "status.ok") }
					} else {
						{ T(ctx, "status.err") }
					}
				</span>
				<span class="text-xs text-muted-foreground">{ T(ctx, "status.health") }</span>
			</div>
			@Readout(d.Uptime, T(ctx, "status.uptime"), "st-uptime", "")
			@Readout(d.HitPct, T(ctx, "status.hits"), "st-hit", "")
		</div>
		<div class="mb-8 grid gap-6 lg:grid-cols-2">
			for _, c := range d.Charts {
				@statusChart(c)
			}
		</div>
		@StatRow() {
			@StatTile("hard-drive", d.Bytes(d.Global.StoredBytes), T(ctx, "status.stored"), "st-stored", "")
			@StatTile("package", Count(d.Global.Paths), T(ctx, "kpi.paths"), "st-paths", "")
			@StatTile("download", Count(d.NarServed), T(ctx, "status.nars"), "st-nars", "")
			@StatTile("network", Count(d.Requests), T(ctx, "status.reqs"), "st-req", "")
			@StatTile("shield", Count(d.AuthFails), T(ctx, "status.authfail"), "st-auth", failTone(d.AuthFails))
			@StatTile("upload", Count(d.PathsPushed), T(ctx, "status.pushed"), "st-pushed", "")
			@StatTile("copy", Count(d.PathsAdopted), T(ctx, "status.adopted"), "st-adopted", "")
			@StatTile("boxes", Count(d.ChunksRecv), T(ctx, "status.chunks"), "st-chunks", "")
			@StatTile("layers", Count(d.ChunksDedup), T(ctx, "status.deduped"), "st-dedup", "")
		}
		<p id="status-updated" class="mt-6 text-center font-mono text-xs text-muted-foreground tabular-nums">{ T(ctx, "status.updated") } { d.Updated }</p>
		@templ.JSONScript("status-poll", map[string]any{
			"url": dataURL(d), "rate": d.Rate,
			"ok": T(ctx, "status.ok"), "err": T(ctx, "status.err"),
			"updated": T(ctx, "status.updated"), "peak": T(ctx, "status.peak"),
		})
		@statusPollScript()
	}
}

// statusSettings is the gear button + sheet holding every view control:
// window presets, custom range, auto-refresh rate. Preset/rate choices are
// links; navigation reloads the page with the new query.
templ statusSettings(d StatusData) {
	@sheet.Sheet(sheet.Props{ID: "status-settings"}) {
		@sheet.Trigger(sheet.TriggerProps{For: "status-settings"}) {
			@WithTooltip(T(ctx, "status.settings")) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Type: button.TypeButton, Attributes: templ.Attributes{"aria-label": T(ctx, "status.settings")}}) {
					@Icon("settings")
				}
			}
		}
		@sheet.Content() {
			@sheet.Header() {
				@sheet.Title() {
					{ T(ctx, "status.settings") }
				}
			}
			<div class="space-y-6 p-4">
				<div class="space-y-2">
					<p class="text-sm font-medium">{ T(ctx, "status.window") }</p>
					<div class="flex flex-wrap gap-1">
						for _, wo := range statusWindows {
							@button.Button(button.Props{Href: windowURL(d, wo.Min), Size: button.SizeSm, Variant: segVariant(wo.Min == d.Window)}) {
								{ wo.Label }
							}
						}
					</div>
				</div>
				<form method="get" action="/admin/status" class="space-y-2">
					<p class="text-sm font-medium">{ T(ctx, "status.range") }</p>
					<input type="hidden" name="rate" value={ strconv.Itoa(d.Rate) }/>
					@datepicker.DatePicker(datepicker.Props{
						Name: "from", EndName: "to", Mode: calendar.SelectionModeRange,
						Value: parseDate(d.From), EndValue: parseDate(d.To),
						Placeholder: T(ctx, "status.from"), EndPlaceholder: T(ctx, "status.to"),
					})
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: segVariant(d.Window == 0), Class: "w-full"}) {
						@Icon("calendar")
						<span>{ T(ctx, "status.apply") }</span>
					}
				</form>
				<div class="space-y-2">
					<p class="text-sm font-medium">{ T(ctx, "status.autorefresh") }</p>
					<div class="flex flex-wrap gap-1">
						for _, rt := range statusRates {
							@button.Button(button.Props{Href: rateURL(d, rt), Size: button.SizeSm, Variant: segVariant(rt == d.Rate)}) {
								{ strconv.Itoa(rt) }s
							}
						}
					</div>
				</div>
			</div>
		}
	}
}

templ statusChart(c ChartData) {
	@card.Card() {
		@card.Header(card.HeaderProps{Class: "flex-row items-baseline justify-between space-y-0"}) {
			@card.Title(card.TitleProps{Class: "text-base"}) {
				{ c.Label }
			}
			<div class="flex items-baseline gap-2">
				<span id={ "cur-" + c.ID } class="font-mono text-lg font-medium tabular-nums">{ c.Cur }</span>
				@badge.Badge(badge.Props{ID: "peak-" + c.ID, Variant: badge.VariantSecondary, Class: peakClass(c.Peak)}) {
					if c.Peak != "" {
						{ T(ctx, "status.peak") } { c.Peak }
					}
				}
			</div>
		}
		@card.Content(card.ContentProps{Class: "relative"}) {
			<p id={ "empty-" + c.ID } class={ "absolute inset-0 flex items-center justify-center text-sm text-muted-foreground", sparseClass(c.Points) }>{ T(ctx, "status.collecting") }</p>
			@chart.Chart(chart.Props{
				ID:      "chart-" + c.ID,
				Variant: chart.VariantLine,
				Class:   "h-48",
				// Time labels, because a series with no x axis cannot be read;
				// horizontal grid only, because the level is what you compare and
				// vertical rules just fence the line in. The ceiling is a round
				// number above the peak (chartMax), so ticks land on round values
				// and the axis stops rescaling under the line on every poll.
				ShowXAxis:   true,
				ShowYAxis:   true,
				ShowXLabels: true,
				ShowYLabels: true,
				ShowYGrid:   true,
				BeginAtZero: chart.Bool(true),
				YMax:        chartMax(c.Points),
				Data: chart.Data{
					Labels: c.Labels,
					Datasets: []chart.Dataset{{
						Label:       c.Label,
						Data:        c.Points,
						BorderColor: c.Color,
						BorderWidth: 2,
						Tension:     0.3,
					}},
				},
			})
		}
	}
}

// sparseClass hides the "collecting" overlay once a chart has a line to draw.
func sparseClass(points []float64) string {
	if len(points) >= 2 {
		return "hidden"
	}
	return ""
}

// peakClass hides the peak badge until there is a peak; the poll script
// unhides it in place.
func peakClass(peak string) string {
	if peak == "" {
		return "hidden"
	}
	return ""
}

// statusPollScript applies the /admin/status/data payload in place: KPI tile
// text, chart headers, and chart datasets via Chart.js update('none') — no
// DOM swaps, no re-render blink.
templ statusPollScript() {
	<script>
		(function () {
			var cfgEl = document.getElementById('status-poll');
			if (!cfgEl) return;
			var cfg = JSON.parse(cfgEl.textContent);
			function setText(id, v) {
				var el = document.getElementById(id);
				if (el) el.textContent = v;
			}
			// niceMax mirrors views.chartMax: the next 1/2/5×10ⁿ above the peak.
			function niceMax(vals) {
				var m = 0;
				for (var i = 0; i < vals.length; i++) {
					if (vals[i] > m) m = vals[i];
				}
				if (m <= 0) return 1;
				var e = Math.pow(10, Math.floor(Math.log10(m)));
				var steps = [1, 2, 5, 10];
				for (var j = 0; j < steps.length; j++) {
					if (m <= steps[j] * e) return steps[j] * e;
				}
				return 10 * e;
			}
			// scaleOpts reaches a chart's own config, never inst.options: that is a
			// resolver proxy, and assigning an object into it writes the proxy back
			// through itself until the stack runs out.
			function scaleOpts(inst, axis) {
				var o = inst.config.options || (inst.config.options = {});
				o.scales = o.scales || {};
				o.scales[axis] = o.scales[axis] || {};
				return o.scales[axis];
			}
			// Time labels lie flat and Chart.js drops whatever will not fit, rather
			// than raking every timestamp at 45 degrees. templui exposes no tick
			// options, so this is done on the live instances.
			function tuneAxes() {
				if (!window.Chart) return;
				document.querySelectorAll('canvas[data-tui-chart-id]').forEach(function (cv) {
					var inst = Chart.getChart(cv.id);
					if (!inst) return;
					var x = scaleOpts(inst, 'x');
					if (x.ticks && x.ticks.maxRotation === 0) return;
					x.ticks = Object.assign({}, x.ticks, {
						maxRotation: 0,
						minRotation: 0,
						autoSkipPadding: 16,
					});
					inst.update('none');
				});
			}
			// templui builds its charts on its own listener, and rebuilds them all
			// on a theme switch to pick up the new surface colours — so there is no
			// single moment to hook, and a rebuilt instance is back on Chart.js'
			// defaults. Sweep for a few seconds after either event; tuneAxes is a
			// no-op on an instance it has already done.
			function tuneBurst() {
				var tries = 0;
				var timer = setInterval(function () {
					tuneAxes();
					if (++tries > 12) clearInterval(timer);
				}, 250);
			}
			tuneBurst();
			var themeWatch = new MutationObserver(tuneBurst);
			themeWatch.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class', 'data-palette'],
			});
			function fmtLabel(ms, longSpan) {
				var t = new Date(ms);
				var hm =
					('0' + t.getHours()).slice(-2) +
					':' +
					('0' + t.getMinutes()).slice(-2);
				// Mirror the server render: date + time past two days.
				return longSpan
					? t.getDate() + '/' + (t.getMonth() + 1) + ' ' + hm
					: hm;
			}
			function apply(d) {
				var h = document.getElementById('st-health');
				if (h) {
					h.textContent = d.healthy ? cfg.ok : cfg.err;
					h.classList.toggle('text-success', d.healthy);
					h.classList.toggle('text-destructive', !d.healthy);
				}
				setText('st-uptime', d.uptime);
				setText('st-hit', d.hitPct);
				setText('st-stored', d.stored);
				setText('st-paths', d.paths);
				setText('st-nars', d.nars);
				setText('st-req', d.requests);
				setText('st-auth', d.authFails);
				setText('st-pushed', d.pathsPushed);
				setText('st-adopted', d.pathsAdopted);
				setText('st-chunks', d.chunksRecv);
				setText('st-dedup', d.chunksDedup);
				setText('status-updated', cfg.updated + ' ' + d.updated);
				var longSpan = d.maxT - d.minT > 48 * 3600 * 1000;
				Object.keys(d.charts || {}).forEach(function (k) {
					var c = d.charts[k];
					setText('cur-' + k, c.cur);
					var em = document.getElementById('empty-' + k);
					if (em) em.classList.toggle('hidden', c.points.length >= 2);
					var pk = document.getElementById('peak-' + k);
					if (pk) {
						pk.classList.toggle('hidden', !c.peak);
						pk.textContent = c.peak ? cfg.peak + ' ' + c.peak : '';
					}
					var inst = window.Chart && Chart.getChart('chart-' + k + '-canvas');
					if (!inst) return;
					inst.data.labels = c.points.map(function (p) {
						return fmtLabel(p[0], longSpan);
					});
					var vals = c.points.map(function (p) {
						return p[1];
					});
					inst.data.datasets[0].data = vals;
					// Same ceiling rule as the server render — see chartMax.
					scaleOpts(inst, 'y').max = niceMax(vals);
					inst.update('none');
				});
				tuneAxes();
			}
			// A boosted navigation swaps the body out from under this script, so
			// the poller has to notice its own page is gone: nothing else would
			// stop it, and every visit to this page would leave one more behind,
			// all of them polling.
			var timer = setInterval(function () {
				if (!cfgEl.isConnected) {
					clearInterval(timer);
					themeWatch.disconnect();
					return;
				}
				fetch(cfg.url, { headers: { Accept: 'application/json' } })
					.then(function (r) {
						if (!r.ok) throw 0;
						return r.json();
					})
					.then(apply)
					.catch(function () {});
			}, cfg.rate * 1000);
		})();
	</script>
}
