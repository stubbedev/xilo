package views

import (
	"context"
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/table"
)

// OrgPageData is one organization's page: members, caches, usage.
type OrgPageData struct {
	Nav       Nav
	Info      OrgInfo
	Caches    []CacheUsage
	AllUsers  []store.User // picker candidates (not yet members)
	CanManage bool         // org admin or instance admin
	Bytes     func(int64) string
	Flash     Flash
}

// Org renders one organization.
templ Org(d OrgPageData) {
	@Layout(d.Info.Account.Slug, "", d.Nav, d.Flash) {
		@Crumbs(Crumb{T(ctx, "org.title"), orgParent(d.Nav)}, Crumb{d.Info.Account.Slug, ""})
		@PageHeaderCode(d.Info.Account.Slug, UsagePhrase(ctx, d.Info))
		<div class="grid gap-8">
			@ListSection(T(ctx, "org.members"), nil) {
				if len(d.Info.Members) == 0 {
					@EmptyState("users", T(ctx, "empty.none"))
				} else {
					@TableCard() {
						@table.Table() {
							@table.Body() {
								for _, m := range d.Info.Members {
									@table.Row() {
										@table.Cell() {
											<div class="flex items-center gap-2">
												@RoleIcon(m.Role)
												<span class="font-medium">{ m.UserName }</span>
											</div>
										}
										@table.Cell(table.CellProps{Class: "text-right"}) {
											if d.CanManage && m.Role != "owner" {
												@RowActions() {
													<form method="post" action={ templ.SafeURL("/admin/org/" + d.Info.Account.Slug + "/members") }>
														<input type="hidden" name="user_id" value={ strconv.FormatInt(m.UserID, 10) }/>
														if m.Role == "admin" {
															<input type="hidden" name="role" value="user"/>
															@RowAction("user-minus", T(ctx, "users.demote"), true)
														} else {
															<input type="hidden" name="role" value="admin"/>
															@RowAction("user-plus", T(ctx, "users.promote"), true)
														}
													</form>
													@ConfirmForm(Confirm{
														ID:             "rm-member-" + strconv.FormatInt(m.UserID, 10),
														Action:         "/admin/org/" + d.Info.Account.Slug + "/members/" + strconv.FormatInt(m.UserID, 10) + "/remove",
														Title:          T(ctx, "org.removetitle"),
														Message:        Tf(ctx, "org.removemsg", m.UserName, d.Info.Account.Slug),
														ConfirmLabel:   T(ctx, "action.remove"),
														ConfirmIcon:    "trash-2",
														Danger:         true,
														TriggerIcon:    "trash-2",
														IconOnly:       true,
														TriggerTooltip: T(ctx, "action.remove"),
														TriggerVariant: button.VariantGhost,
													})
												}
											}
										}
									}
								}
							}
						}
					}
				}
				if d.CanManage {
					if len(d.AllUsers) > 0 {
						<form method="post" action={ templ.SafeURL("/admin/org/" + d.Info.Account.Slug + "/members") } class="mt-4 flex flex-wrap items-end gap-2">
							<div class="min-w-48 flex-1">
								@Field("", T(ctx, "org.addmember")) {
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "user_id"}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: T(ctx, "org.pickuser")})
										}
										@selectbox.Content() {
											for _, cand := range d.AllUsers {
												@selectbox.Item(selectbox.ItemProps{Value: strconv.FormatInt(cand.ID, 10)}) {
													{ cand.Name }
												}
											}
										}
									}
								}
							</div>
							<div class="w-36">
								@Field("", T(ctx, "users.role")) {
									@roleSelect("role", "user")
								}
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								@Icon("user-plus")
								<span>{ T(ctx, "action.add") }</span>
							}
						</form>
					} else {
						<p class="mt-4 text-sm text-muted-foreground">{ T(ctx, "org.nocandidates") }</p>
					}
				}
			}
			@ListSection(T(ctx, "org.caches"), nil) {
				if len(d.Caches) == 0 {
					@EmptyState("database", T(ctx, "empty.none")) {
						@button.Button(button.Props{Href: "/admin", Size: button.SizeSm, Variant: button.VariantOutline}) {
							@Icon("plus")
							<span>{ T(ctx, "caches.new") }</span>
						}
					}
				} else {
					<div class="divide-y border-y">
						for _, u := range d.Caches {
							@cacheRow(u, d.Bytes)
						}
					</div>
				}
			}
		</div>
	}
}

// roleSelect is a member/admin role picker.
templ roleSelect(name, value string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name}) {
			@selectbox.Value(selectbox.ValueProps{})
		}
		@selectbox.Content() {
			@selectbox.Item(selectbox.ItemProps{Value: "user", Selected: value == "user"}) {
				{ T(ctx, "role.user") }
			}
			@selectbox.Item(selectbox.ItemProps{Value: "admin", Selected: value == "admin"}) {
				{ T(ctx, "role.admin") }
			}
		}
	}
}

// UsagePhrase renders "12 GiB stored (of 50 GiB)   3 GiB served this month
// plan team   N members" — clauses set apart by space, see MetaSep.
func UsagePhrase(ctx context.Context, o OrgInfo) string {
	out := o.UsageLine(ctx)
	switch n := len(o.Members); {
	case n == 1:
		out += MetaSep + Tf(ctx, "org.membercount", n)
	case n > 1:
		out += MetaSep + Tf(ctx, "org.memberscount", n)
	}
	return out
}

// orgParent is where the organizations list lives for this viewer: the
// instance settings for admins, the account page for everyone else.
func orgParent(n Nav) string {
	if n.IsAdmin {
		return "/admin/settings"
	}
	return "/admin/account"
}
