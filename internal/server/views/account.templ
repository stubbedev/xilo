package views

import (
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/inputotp"
	"github.com/templui/templui/components/selectbox"
)

// AccountData is everything the personal account page renders.
type AccountData struct {
	Nav          Nav
	User         *store.User
	TOTPEnabled  bool
	Passkeys     []store.Passkey
	CanCreateOrg bool // multi-tenant and the user's plan allows organizations
	Flash        Flash
}

// Account is the personal page: sign-in identity and credentials.
//
// Every credential is one row — what it is, what it currently says, and the
// control that changes it — because that is what these are: settings with a
// current value, not forms waiting to be filled in. The forms live in the
// dialogs the rows open, which is also what keeps the filled Save button
// where it belongs: on the thing that commits, never on the page ground.
templ Account(d AccountData) {
	@Layout(T(ctx, "nav.account"), "account", d.Nav, d.Flash) {
		@PageHeader(T(ctx, "nav.account"), Tf(ctx, "acct.subtitle", d.User.Name))
		<div class="grid gap-8">
			@ListSection(T(ctx, "acct.signin"), nil) {
				<div class="divide-y border-y">
					@SettingRow(T(ctx, "acct.email"), orDash(d.User.Email)) {
						@emailDialog(d)
					}
					@SettingRow(T(ctx, "login.password"), "") {
						@passwordDialog()
					}
					@SettingRow(T(ctx, "set.2fa"), totpState(ctx, d.TOTPEnabled)) {
						if d.TOTPEnabled {
							@ConfirmForm(Confirm{
								ID:             "totp-off",
								Action:         "/admin/account/totp/disable",
								Title:          T(ctx, "confirm.2fa"),
								Message:        T(ctx, "set.2fa.offmsg"),
								ConfirmLabel:   T(ctx, "set.2fa.disable"),
								ConfirmIcon:    "shield-off",
								Danger:         true,
								TriggerLabel:   T(ctx, "set.2fa.disable"),
								TriggerIcon:    "shield-off",
								TriggerVariant: button.VariantOutline,
							}) {
								@Field("totp-off-current", T(ctx, "set.current")) {
									@input.Input(input.Props{ID: "totp-off-current", Name: "current", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
								}
							}
						} else {
							@totpEnrollDialog()
						}
					}
				</div>
			}
			@ListSection(T(ctx, "set.passkeys"), sectionAction(len(d.Passkeys) > 0, passkeyAddButton())) {
				if len(d.Passkeys) == 0 {
					@EmptyState("fingerprint-pattern", T(ctx, "empty.none")) {
						@passkeyAddButton()
					}
				} else {
					<div class="divide-y border-y">
						for _, pk := range d.Passkeys {
							<div class="flex items-center justify-between gap-3 py-2">
								<div class="flex min-w-0 items-center gap-2 text-sm">
									@Icon("fingerprint-pattern")
									<span class="truncate font-medium">{ pk.Name }</span>
									@Meta() {
										{ Ago(ctx, pk.Created) }
									}
								</div>
								@ConfirmForm(Confirm{
									ID:             "pk-" + strconv.FormatInt(pk.ID, 10),
									Action:         "/admin/passkeys/" + strconv.FormatInt(pk.ID, 10) + "/delete",
									Title:          T(ctx, "pk.removetitle"),
									Message:        Tf(ctx, "pk.removemsg", pk.Name),
									ConfirmLabel:   T(ctx, "action.remove"),
									ConfirmIcon:    "trash-2",
									Danger:         true,
									TriggerIcon:    "trash-2",
									IconOnly:       true,
									TriggerTooltip: T(ctx, "action.remove"),
									TriggerVariant: button.VariantGhost,
								})
							</div>
						}
					</div>
				}
			}
			@ListSection(T(ctx, "acct.appearance"), nil) {
				// Two preferences that apply the moment they are picked, so they
				// have no Save and therefore no card around them.
				<form method="post" action="/admin/account/appearance" class="divide-y border-y" onchange="if (event.target.name === 'theme' || event.target.name === 'locale') this.submit()">
					@SettingRow(T(ctx, "acct.palette"), "") {
						<div class="w-48">
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "theme", Attributes: templ.Attributes{"aria-label": T(ctx, "acct.palette")}}) {
									@selectbox.Value(selectbox.ValueProps{})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: noSearch(len(Palettes))}) {
									for _, p := range Palettes {
										@selectbox.Item(selectbox.ItemProps{Value: p.ID, Selected: p.ID == d.User.Theme}) {
											{ p.Name }
										}
									}
								}
							}
						</div>
					}
					@SettingRow(T(ctx, "acct.language"), "") {
						<div class="w-48">
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "locale", Attributes: templ.Attributes{"aria-label": T(ctx, "acct.language")}}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: T(ctx, "acct.langauto")})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: noSearch(len(Locales) + 1)}) {
									@selectbox.Item(selectbox.ItemProps{Value: "", Selected: d.User.Locale == ""}) {
										{ T(ctx, "acct.langauto") }
									}
									for _, l := range Locales {
										@selectbox.Item(selectbox.ItemProps{Value: l.ID, Selected: l.ID == d.User.Locale}) {
											{ l.Name }
										}
									}
								}
							}
						</div>
					}
				</form>
			}
		</div>
	}
}

// emailDialog changes the sign-in address.
templ emailDialog(d AccountData) {
	@dialog.Dialog(dialog.Props{ID: "dlg-email"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-email"}) {
			@rowOpener("square-pen", T(ctx, "action.edit"))
		}
		@DialogBox(T(ctx, "acct.email"), T(ctx, "acct.emailhint"), false) {
			<form method="post" action="/admin/account/email" class="mt-2 space-y-4">
				@Field("email", T(ctx, "acct.emailaddr")) {
					@input.Input(input.Props{ID: "email", Name: "email", Type: input.TypeEmail, Value: d.User.Email, Placeholder: T(ctx, "ph.email"), Attributes: templ.Attributes{"autocomplete": "email"}})
				}
				@DialogFooter("dlg-email", "check", T(ctx, "action.save"))
			</form>
		}
	}
}

// passwordDialog is the change-password form. The strength verdict is the
// server's (hx-post to the check endpoint), rendered under the fields.
templ passwordDialog() {
	@dialog.Dialog(dialog.Props{ID: "dlg-pw"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-pw"}) {
			@rowOpener("square-pen", T(ctx, "action.edit"))
		}
		@DialogBox(T(ctx, "login.password"), T(ctx, "set.password"), false) {
			<form method="post" action="/admin/account/password" class="mt-2 space-y-4">
				@Field("cur-pw", T(ctx, "set.current")) {
					@input.Input(input.Props{ID: "cur-pw", Name: "current", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
				}
				@Field("new-pw", T(ctx, "set.new")) {
					@input.Input(input.Props{ID: "new-pw", Name: "new", Type: input.TypePassword, Required: true, Attributes: pwCheckAttrs()})
				}
				@Field("new-pw2", T(ctx, "set.new2")) {
					@input.Input(input.Props{ID: "new-pw2", Name: "confirm", Type: input.TypePassword, Required: true, Attributes: pwCheckAttrs()})
				}
				<span id="pw-hint" class="block text-sm"></span>
				@DialogFooter("dlg-pw", "check", T(ctx, "action.save"))
			</form>
		}
	}
}

// totpEnrollDialog is the enrolment step. The dialog is on the page and opens
// like any other; the same click asks the server for a secret and fills the
// body with the QR, because there is nothing to draw until one exists.
templ totpEnrollDialog() {
	@dialog.Dialog(dialog.Props{ID: "dlg-totp"}) {
		@dialog.Trigger(dialog.TriggerProps{For: "dlg-totp"}) {
			@button.Button(button.Props{
				Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeButton,
				Attributes: templ.Attributes{
					"hx-post":   "/admin/account/totp/enroll",
					"hx-target": "#totp-body",
					"hx-swap":   "innerHTML",
				},
			}) {
				@Icon("shield")
				<span>{ T(ctx, "set.2fa.enable") }</span>
			}
		}
		@DialogBox(T(ctx, "set.enroll"), T(ctx, "set.enrollhint"), false) {
			<div id="totp-body" class="mt-2"></div>
		}
	}
}

// passkeyAddButton starts the browser's own passkey ceremony.
templ passkeyAddButton() {
	@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"onclick": "xiloPasskeyRegister()"}}) {
		@Icon("plus")
		<span>{ T(ctx, "action.add") }</span>
	}
}

// rowOpener is the control that ends a SettingRow: outline, small, labelled —
// it opens a dialog, so it is never the filled button.
templ rowOpener(icon, label string) {
	@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeButton}) {
		@Icon(icon)
		<span>{ label }</span>
	}
}

// pwCheckAttrs wires a password input to the server-side strength check.
func pwCheckAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-post":      "/admin/account/password/check",
		"hx-trigger":   "input changed delay:400ms",
		"hx-include":   "closest form",
		"hx-params":    "new,confirm",
		"hx-target":    "#pw-hint",
		"hx-swap":      "innerHTML",
		"autocomplete": "new-password",
		"minlength":    "8",
	}
}

// PwHint renders the server's verdict on the new password pair.
templ PwHint(state string) {
	switch state {
		case "short":
			<span class="text-warning">{ T(ctx, "set.pw.short") }</span>
		case "mismatch":
			<span class="text-warning">{ T(ctx, "flash.pwmismatch") }</span>
		case "weak":
			<span class="text-warning">{ T(ctx, "set.pw.weak") }</span>
		case "strong":
			<span class="text-success">{ T(ctx, "set.pw.strong") }</span>
	}
}

// TOTPEnrollBody fills the enrolment dialog: scan the code, type six digits,
// done. The whole flow used to be a page of its own, which made adding a
// second factor feel like leaving the account behind. A wrong code re-renders
// this body in place, with the same secret, and the dialog stays open.
templ TOTPEnrollBody(qrDataURI, secret, errMsg string) {
	<form
		method="post"
		action="/admin/account/totp/enable"
		class="flex flex-col items-center gap-4"
		hx-post="/admin/account/totp/enable"
		hx-target="#totp-body"
		hx-swap="innerHTML"
	>
		<img class="rounded-lg border bg-white p-2" width="180" height="180" src={ qrDataURI } alt={ T(ctx, "set.qralt") }/>
		<div class="text-center">
			<p class="text-xs text-muted-foreground">{ T(ctx, "set.manual") }</p>
			<code class="font-mono text-xs">{ secret }</code>
		</div>
		@inputotp.InputOTP(inputotp.Props{ID: "totp-code", Name: "code"}) {
			@inputotp.Group() {
				@inputotp.Slot(inputotp.SlotProps{Index: 0})
				@inputotp.Slot(inputotp.SlotProps{Index: 1})
				@inputotp.Slot(inputotp.SlotProps{Index: 2})
			}
			@inputotp.Separator()
			@inputotp.Group() {
				@inputotp.Slot(inputotp.SlotProps{Index: 3})
				@inputotp.Slot(inputotp.SlotProps{Index: 4})
				@inputotp.Slot(inputotp.SlotProps{Index: 5})
			}
		}
		if errMsg != "" {
			<p class="text-sm text-warning">{ errMsg }</p>
		}
		<div class="w-full">
			@DialogFooter("dlg-totp", "check", T(ctx, "set.2fa.enable"))
		</div>
	</form>
}
