package views

import (
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/form"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/inputotp"
	"github.com/templui/templui/components/selectbox"
)

// AccountData is everything the personal account page renders.
type AccountData struct {
	Nav          Nav
	User         *store.User
	TOTPEnabled  bool
	Passkeys     []store.Passkey
	CanCreateOrg bool // multi-tenant and the user's plan allows organizations
	Flash        Flash
}

// Account is the personal page: sign-in identity and credentials.
templ Account(d AccountData) {
	@Layout(T(ctx, "nav.account"), "account", d.Nav, d.Flash) {
		@PageHeader(T(ctx, "nav.account"), Tf(ctx, "acct.subtitle", d.User.Name))
		// Two columns on a wide screen. Stacked full width, six identical cards
		// made a 1800px scroll of the same box, and a password field a thousand
		// pixels wide for eight characters.
		<div class="grid items-start gap-6 lg:grid-cols-2">
			@SettingsCard(T(ctx, "acct.email"), T(ctx, "acct.emailhint")) {
				<form method="post" action="/admin/account/email" class="flex items-end gap-2">
					@form.Item(form.ItemProps{Class: "flex-1"}) {
						@form.Label(form.LabelProps{For: "email"}) {
							{ T(ctx, "acct.emailaddr") }
						}
						@input.Input(input.Props{ID: "email", Name: "email", Type: input.TypeEmail, Value: d.User.Email, Placeholder: T(ctx, "ph.email"), Attributes: templ.Attributes{"autocomplete": "email"}})
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						@Icon("check")
						<span>{ T(ctx, "action.save") }</span>
					}
				</form>
			}
			@SettingsCard(T(ctx, "acct.appearance"), T(ctx, "acct.appearancehint")) {
				<form method="post" action="/admin/account/appearance" class="grid gap-4 sm:grid-cols-2" onchange="if (event.target.name === 'theme' || event.target.name === 'locale') this.submit()">
						@Field("", T(ctx, "acct.palette")) {
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "theme", Attributes: templ.Attributes{"aria-label": T(ctx, "acct.palette")}}) {
									@selectbox.Value(selectbox.ValueProps{})
								}
								@selectbox.Content() {
									for _, p := range Palettes {
										@selectbox.Item(selectbox.ItemProps{Value: p.ID, Selected: p.ID == d.User.Theme}) {
											{ p.Name }
										}
									}
								}
							}
						}
						@Field("", T(ctx, "acct.language")) {
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "locale", Attributes: templ.Attributes{"aria-label": T(ctx, "acct.language")}}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: T(ctx, "acct.langauto")})
								}
								@selectbox.Content() {
									@selectbox.Item(selectbox.ItemProps{Value: "", Selected: d.User.Locale == ""}) {
										{ T(ctx, "acct.langauto") }
									}
									for _, l := range Locales {
										@selectbox.Item(selectbox.ItemProps{Value: l.ID, Selected: l.ID == d.User.Locale}) {
											{ l.Name }
										}
									}
								}
							}
						}
				</form>
			}
			@SettingsCard(T(ctx, "set.passkeys"), T(ctx, "set.passkeys.hint")) {
				if len(d.Passkeys) == 0 {
					@EmptyState("fingerprint-pattern", T(ctx, "empty.none"))
				} else {
					<div class="divide-y border-y">
						for _, pk := range d.Passkeys {
							<div class="flex items-center justify-between gap-3 py-2">
								<div class="flex min-w-0 items-center gap-2 text-sm">
									@Icon("fingerprint-pattern")
									<span class="truncate font-medium">{ pk.Name }</span>
									@Meta() {
										{ Ago(ctx, pk.Created) }
									}
								</div>
								@ConfirmForm(Confirm{
									ID:             "pk-" + strconv.FormatInt(pk.ID, 10),
									Action:         "/admin/passkeys/" + strconv.FormatInt(pk.ID, 10) + "/delete",
									Title:          T(ctx, "pk.removetitle"),
									Message:        Tf(ctx, "pk.removemsg", pk.Name),
									ConfirmLabel:   T(ctx, "action.remove"),
									ConfirmIcon:    "trash-2",
									Danger:         true,
									TriggerIcon:    "trash-2",
									IconOnly:       true,
									TriggerTooltip: T(ctx, "action.remove"),
									TriggerVariant: button.VariantGhost,
								})
							</div>
						}
					</div>
				}
				@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"onclick": "xiloPasskeyRegister()"}}) {
					@Icon("fingerprint-pattern")
					<span>{ T(ctx, "action.add") }</span>
				}
			}
			@SettingsCard(T(ctx, "set.2fa"), T(ctx, "set.2fa.hint")) {
				if d.TOTPEnabled {
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div class="flex items-center gap-2 text-sm">
								@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "gap-1"}) {
									@Icon("shield-check")
									<span>{ T(ctx, "set.2fa.on") }</span>
								}
							</div>
							@ConfirmForm(Confirm{
								ID:             "totp-off",
								Action:         "/admin/account/totp/disable",
								Title:          T(ctx, "confirm.2fa"),
								Message:        T(ctx, "set.2fa.offmsg"),
								ConfirmLabel:   T(ctx, "set.2fa.disable"),
								ConfirmIcon:    "shield-off",
								Danger:         true,
								TriggerLabel:   T(ctx, "set.2fa.disable"),
								TriggerIcon:    "shield-off",
								TriggerVariant: button.VariantOutline,
							}) {
								@Field("totp-off-current", T(ctx, "set.current")) {
									@input.Input(input.Props{ID: "totp-off-current", Name: "current", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
								}
							}
						</div>
					} else {
						@ActionRow(T(ctx, "set.2fa.protect")) {
							<form method="post" action="/admin/account/totp/enroll">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									@Icon("shield")
									<span>{ T(ctx, "set.2fa.enable") }</span>
								}
							</form>
						}
				}
			}
			if d.CanCreateOrg {
				@SettingsCard(T(ctx, "acct.orgs"), T(ctx, "acct.orghint")) {
					@newOrgDialog("/admin/neworg")
				}
			}
			@SettingsCard(T(ctx, "login.password"), T(ctx, "set.password")) {
				<form method="post" action="/admin/account/password" class="space-y-4">
					@Field("cur-pw", T(ctx, "set.current")) {
						@input.Input(input.Props{ID: "cur-pw", Name: "current", Type: input.TypePassword, Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
					}
					@Field("new-pw", T(ctx, "set.new")) {
						@input.Input(input.Props{ID: "new-pw", Name: "new", Type: input.TypePassword, Required: true, Attributes: pwCheckAttrs()})
					}
					@Field("new-pw2", T(ctx, "set.new2")) {
						@input.Input(input.Props{ID: "new-pw2", Name: "confirm", Type: input.TypePassword, Required: true, Attributes: pwCheckAttrs()})
					}
					<div class="flex flex-wrap items-center justify-between gap-3">
						<span id="pw-hint" class="text-sm"></span>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							@Icon("check")
							<span>{ T(ctx, "set.update") }</span>
						}
					</div>
				</form>
			}
		</div>
	}
}

// pwCheckAttrs wires a password input to the server-side strength check.
func pwCheckAttrs() templ.Attributes {
	return templ.Attributes{
		"hx-post":      "/admin/account/password/check",
		"hx-trigger":   "input changed delay:400ms",
		"hx-include":   "closest form",
		"hx-params":    "new,confirm",
		"hx-target":    "#pw-hint",
		"hx-swap":      "innerHTML",
		"autocomplete": "new-password",
		"minlength":    "8",
	}
}

// PwHint renders the server's verdict on the new password pair.
templ PwHint(state string) {
	switch state {
		case "short":
			<span class="text-warning">{ T(ctx, "set.pw.short") }</span>
		case "mismatch":
			<span class="text-warning">{ T(ctx, "flash.pwmismatch") }</span>
		case "weak":
			<span class="text-warning">{ T(ctx, "set.pw.weak") }</span>
		case "strong":
			<span class="text-success">{ T(ctx, "set.pw.strong") }</span>
	}
}

templ TOTPEnroll(nav Nav, qrDataURI, secret string) {
	@totpEnrollPage(nav, qrDataURI, secret, "")
}

templ TOTPEnrollErr(nav Nav, qrDataURI, secret, errMsg string) {
	@totpEnrollPage(nav, qrDataURI, secret, errMsg)
}

templ totpEnrollPage(nav Nav, qrDataURI, secret, errMsg string) {
	@Layout(T(ctx, "set.enroll"), "account", nav, Flash{Msg: errMsg}) {
		@PageHeader(T(ctx, "set.enroll"), T(ctx, "set.enrollhint"))
		<div class="mx-auto max-w-md">
			@card.Card() {
				@card.Content(card.ContentProps{Class: "flex flex-col items-center gap-4"}) {
					<img class="rounded-lg border bg-white p-2" width="200" height="200" src={ qrDataURI } alt={ T(ctx, "set.qralt") }/>
					<div class="text-center text-sm text-muted-foreground">
						<p>{ T(ctx, "set.manual") }</p>
						<code class="font-mono text-xs">{ secret }</code>
					</div>
					<form method="post" action="/admin/account/totp/enable" class="flex w-full flex-col items-center gap-4">
						@inputotp.InputOTP(inputotp.Props{ID: "totp-code", Name: "code"}) {
							@inputotp.Group() {
								@inputotp.Slot(inputotp.SlotProps{Index: 0})
								@inputotp.Slot(inputotp.SlotProps{Index: 1})
								@inputotp.Slot(inputotp.SlotProps{Index: 2})
							}
							@inputotp.Separator()
							@inputotp.Group() {
								@inputotp.Slot(inputotp.SlotProps{Index: 3})
								@inputotp.Slot(inputotp.SlotProps{Index: 4})
								@inputotp.Slot(inputotp.SlotProps{Index: 5})
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							@Icon("check")
							<span>{ T(ctx, "set.2fa.enable") }</span>
						}
					</form>
				}
			}
		</div>
	}
}
