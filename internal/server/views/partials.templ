package views

import (
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/breadcrumb"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/copybutton"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/pagination"
	"github.com/templui/templui/components/table"
	"github.com/templui/templui/components/toast"
	"github.com/templui/templui/components/tooltip"
)

// WithTooltip wraps its children (typically an icon-only control) in a hover
// tooltip carrying `text`. Wrappers are display:contents — layout-neutral.
templ WithTooltip(text string) {
	@tooltip.Tooltip() {
		@tooltip.Trigger() {
			{ children... }
		}
		@tooltip.Content(tooltip.ContentProps{ShowArrow: true, Class: "text-xs"}) {
			{ text }
		}
	}
}

// FlashToast surfaces a one-shot message as a templui toast. When the flash
// carries a secret Code, a persistent SecretCard is rendered too (a copyable
// secret must not auto-dismiss).
templ FlashToast(flash Flash) {
	if flash.Msg != "" {
		@toast.Toast(toast.Props{
			Description:   flash.Msg,
			Position:      toast.PositionBottomRight,
			Duration:      toastDuration(flash),
			Dismissible:   true,
			ShowIndicator: flash.Code == "",
			Icon:          true,
		})
	}
	if flash.Code != "" {
		@SecretCard(flash.Code)
	}
}

// SecretCard shows a one-time secret with a copy button — persistent, since it
// is shown only once.
templ SecretCard(code string) {
	@card.Card(card.Props{Class: "mb-6 border-primary/40"}) {
		@card.Content(card.ContentProps{Class: "flex items-center gap-3 p-4"}) {
			<code id={ copyID(code) } class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs scrollbar-none">{ code }</code>
			@copybutton.CopyButton(copybutton.Props{TargetID: copyID(code), Class: "shrink-0"})
		}
	}
}

// SearchInput is a live-search box: typing swaps just `target` in place via
// htmx, preserving the rest of the page.
templ SearchInput(action, name, value, placeholder, target string) {
	@input.Input(input.Props{
		Name: name, Value: value, Type: input.TypeSearch, Placeholder: placeholder,
		Class: "h-8 w-full sm:w-64",
		Attributes: templ.Attributes{
			"hx-get":       action,
			"hx-trigger":   "input changed delay:300ms, search",
			"hx-target":    target,
			"hx-select":    target,
			"hx-swap":      "outerHTML",
			"hx-indicator": target,
			"hx-push-url":  "true",
			"autocomplete": "off",
			"aria-label":   placeholder,
		},
	})
}

// PageHeader is a page title + optional subtitle, with a right-aligned actions
// slot (children).
templ PageHeader(title, subtitle string) {
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<div class="space-y-1">
			<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
			if subtitle != "" {
				<p class="text-sm text-muted-foreground">{ subtitle }</p>
			}
		</div>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// Crumb is one step of a Crumbs trail; the last item's Href is ignored.
type Crumb struct {
	Label, Href string
}

// Crumbs is the location trail above deep pages (cache, store path): every
// step but the last is a link back up.
templ Crumbs(items ...Crumb) {
	@breadcrumb.Breadcrumb(breadcrumb.Props{Class: "mb-4"}) {
		@breadcrumb.List() {
			for i, c := range items {
				@breadcrumb.Item() {
					if i > 0 {
						@breadcrumb.Separator()
					}
					if i == len(items)-1 {
						@breadcrumb.Page() {
							{ c.Label }
						}
					} else {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: c.Href}) {
							{ c.Label }
						}
					}
				}
			}
		}
	}
}

// CardHeaderRow is a card title with a right-aligned action (children).
templ CardHeaderRow(title string) {
	@card.Header(card.HeaderProps{Class: "flex-row items-center justify-between space-y-0"}) {
		@card.Title() {
			{ title }
		}
		{ children... }
	}
}

// ListBox is the in-card list shell: one bordered, rounded box around a
// table or divided rows. Not a nested card. Wide tables scroll sideways
// inside it instead of pushing the page.
templ ListBox() {
	<div class="divide-y overflow-x-auto rounded-lg border">
		{ children... }
	</div>
}

// TableCard is a card holding nothing but a table. Sortable tables are
// table-fixed with sized meta columns, so below a floor the primary column
// would collapse to nothing: the floor makes the table scroll inside the
// card instead.
templ TableCard() {
	@card.Card(card.Props{Class: "overflow-x-auto [&_table]:min-w-[48rem]"}) {
		{ children... }
	}
}

// RowAction is the icon-only ghost button used in table rows and card
// corners: tooltip plus aria-label, one size everywhere. submit makes it a
// one-click form action; otherwise it is a plain button (dialog triggers).
templ RowAction(icon, label string, submit bool) {
	@WithTooltip(label) {
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Type: rowActionType(submit), Class: "size-8", Attributes: templ.Attributes{"aria-label": label}}) {
			@Icon(icon)
		}
	}
}

// PlusButton is the house create-trigger: primary, small, plus icon.
templ PlusButton(label string) {
	@button.Button(button.Props{Size: button.SizeSm}) {
		@Icon("plus")
		<span>{ label }</span>
	}
}

// DialogBox is a form dialog's body: title, one-line hint, then the form
// (children). wide picks the lg width used by multi-field forms.
templ DialogBox(title, hint string, wide bool) {
	@dialog.Content(dialog.ContentProps{Class: dialogWidth(wide)}) {
		@dialog.Header() {
			@dialog.Title() {
				{ title }
			}
			@dialog.Description() {
				{ hint }
			}
		}
		{ children... }
	}
}

// DialogFooter is the cancel + submit row every form dialog ends with.
templ DialogFooter(dlgID, icon, label string) {
	@dialog.Footer() {
		@dialog.Close(dialog.CloseProps{For: dlgID}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
				{ T("action.cancel") }
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			@Icon(icon)
			<span>{ label }</span>
		}
	}
}

// ActionRow is a sentence with its action on the right: "Rotate the key" +
// button, "Protect your account" + Enable. Wraps on narrow screens.
templ ActionRow(text string) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<p class="text-sm text-muted-foreground">{ text }</p>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// SectionHeader is a lighter heading for a card/region, with an actions slot.
templ SectionHeader(title string) {
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="text-lg font-semibold tracking-tight">{ title }</h2>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// StatTile is one KPI: icon, big value, label. A non-empty id marks the value
// for live updates; tone adds a text color class to the value.
templ StatTile(icon, value, label, id, tone string) {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex items-center gap-4 p-4"}) {
			<div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground">
				@IconClass(icon, 20, "")
			</div>
			<div class="min-w-0">
				<div
					class={ "truncate text-2xl font-semibold tabular-nums", tone }
					if id != "" {
						id={ id }
					}
				>{ value }</div>
				<div class="truncate text-xs text-muted-foreground">{ label }</div>
			</div>
		}
	}
}

// EmptyState is the shared empty-list block: icon, message, optional action.
templ EmptyState(icon, msg string) {
	@card.Card(card.Props{Class: "flex flex-col items-center gap-3 border-dashed bg-transparent px-6 py-12 text-center shadow-none"}) {
		<span class="text-muted-foreground">
			@IconClass(icon, 32, "")
		</span>
		<p class="text-sm text-muted-foreground">{ msg }</p>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	}
}

// PagerNav renders prev/next controls; nothing when there is a single page.
templ PagerNav(p Pager) {
	if p.Pages > 1 {
		@pagination.Pagination(pagination.Props{Class: "mt-4"}) {
			@pagination.Content() {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{Href: p.Prev, Disabled: p.Prev == "", Label: T("pager.prev"), Attributes: hxSwapAttrs(p.Prev, p.Target)})
				}
				@pagination.Item() {
					<span class="px-2 text-sm text-muted-foreground tabular-nums">{ itoa(int64(p.Page)) } / { itoa(int64(p.Pages)) }</span>
				}
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{Href: p.Next, Disabled: p.Next == "", Label: T("pager.next"), Attributes: hxSwapAttrs(p.Next, p.Target)})
				}
			}
		}
	}
}

// SortHead is a clickable, direction-indicating table header cell; class sets
// a stable column width (tables render with table-fixed).
templ SortHead(s SortCtx, key, label, class string) {
	@table.Head(table.HeadProps{Class: class}) {
		<a
			class="inline-flex items-center gap-1 hover:text-foreground"
			href={ templ.SafeURL(s.URL(key)) }
			aria-sort={ ariaSort(s, key) }
			{ hxSwapAttrs(s.URL(key), s.Target)... }
		>
			<span>{ label }</span>
			if s.Key == key {
				if s.Dir == "asc" {
					@IconClass("chevron-up", 12, "")
				} else {
					@IconClass("chevron-down", 12, "")
				}
			}
		</a>
	}
}

// Confirm parameterizes a confirm-before-POST action: an inline trigger button
// that opens a dialog; confirming submits `Action`. Extra hidden inputs go in
// the children slot.
type Confirm struct {
	ID             string
	Action         string
	Title          string
	Message        string
	ConfirmLabel   string
	ConfirmIcon    string
	Danger         bool
	TriggerLabel   string
	TriggerIcon    string
	TriggerVariant button.Variant
	IconOnly       bool
	TriggerTooltip string
}

templ ConfirmForm(c Confirm) {
	@dialog.Dialog(dialog.Props{ID: c.ID}) {
		@dialog.Trigger(dialog.TriggerProps{For: c.ID}) {
			if c.IconOnly && c.TriggerTooltip != "" {
				@WithTooltip(c.TriggerTooltip) {
					@confirmTriggerButton(c)
				}
			} else {
				@confirmTriggerButton(c)
			}
		}
		@DialogBox(c.Title, c.Message, false) {
			<form method="post" action={ templ.SafeURL(c.Action) } class="mt-2">
				{ children... }
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: c.ID}) {
						@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
							{ T("action.cancel") }
						}
					}
					@button.Button(button.Props{Variant: confirmVariant(c.Danger), Type: button.TypeSubmit}) {
						if c.ConfirmIcon != "" {
							@Icon(c.ConfirmIcon)
						}
						<span>{ c.ConfirmLabel }</span>
					}
				}
			</form>
		}
	}
}

// confirmTriggerButton is the inline trigger button for a Confirm.
templ confirmTriggerButton(c Confirm) {
	@button.Button(confirmTriggerProps(c)) {
		@Icon(c.TriggerIcon)
		if !c.IconOnly {
			<span>{ c.TriggerLabel }</span>
		}
	}
}

// StatusIcon renders a token's status as one glyph (check, clock, ban); the
// word rides in the tooltip and the aria-label.
templ StatusIcon(status string) {
	@WithTooltip(T("tok." + status)) {
		<span class={ "inline-flex", statusTone(status) } role="img" aria-label={ T("tok." + status) }>
			@Icon(statusIcon(status))
		</span>
	}
}

// VisBadge shows a cache's public/private state.
templ VisBadge(public bool) {
	if public {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "gap-1"}) {
			@Icon("globe")
			<span>{ T("vis.public") }</span>
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "gap-1"}) {
			@Icon("lock")
			<span>{ T("vis.private") }</span>
		}
	}
}

// PermBadges renders a token's permissions as small labelled badges.
templ PermBadges(perms []string) {
	<div class="flex flex-wrap gap-1">
		for _, p := range perms {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ T("perm." + p) }
			}
		}
	</div>
}
