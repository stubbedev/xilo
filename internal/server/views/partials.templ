package views

import (
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/breadcrumb"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/copybutton"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/pagination"
	"github.com/templui/templui/components/progress"
	"github.com/templui/templui/components/table"
	"github.com/templui/templui/components/toast"
	"github.com/templui/templui/components/tooltip"
)

// WithTooltip wraps its children (typically an icon-only control) in a hover
// tooltip carrying `text`. Wrappers are display:contents — layout-neutral.
templ WithTooltip(text string) {
	@tooltip.Tooltip() {
		@tooltip.Trigger() {
			{ children... }
		}
		// No arrow, and the same delays templui's sidebar uses for its own
		// tooltips: instant ones flicker as the pointer crosses a row of icon
		// buttons. Size, padding and colour live in css/input.css so this and
		// the sidebar's built-in tooltip cannot drift apart.
		@tooltip.Content(tooltip.ContentProps{HoverDelay: 200, HoverOutDelay: 100}) {
			{ text }
		}
	}
}

// FlashToast surfaces a one-shot message as a templui toast. When the flash
// carries a secret Code, a persistent SecretCard is rendered too (a copyable
// secret must not auto-dismiss).
templ FlashToast(flash Flash) {
	if flash.Msg != "" {
		@toast.Toast(toast.Props{
			Description:   flash.Msg,
			Position:      toast.PositionBottomRight,
			Duration:      toastDuration(flash),
			Dismissible:   true,
			ShowIndicator: flash.Code == "",
			Icon:          true,
		})
	}
	if flash.Code != "" {
		@SecretCard(flash.Code)
	}
}

// SecretCard shows a one-time secret with a copy button — persistent, since it
// is shown only once.
templ SecretCard(code string) {
	@card.Card(card.Props{Class: "mb-6 border-primary/40"}) {
		@card.Content(card.ContentProps{Class: "flex items-center gap-3 p-4"}) {
			<code id={ copyID(code) } class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs scrollbar-none">{ code }</code>
			@copybutton.CopyButton(copybutton.Props{TargetID: copyID(code), Class: "shrink-0"})
		}
	}
}

// SearchInput is a live-search box: typing swaps just `target` in place via
// htmx, preserving the rest of the page.
templ SearchInput(action, name, value, placeholder, target string) {
	// The width has to live on a box of our own: templui wraps every input in
	// a hard-coded `relative w-full` div, so sizing the input alone leaves the
	// wrapper spanning the row and the field pinned to the section title
	// instead of sitting beside its create button.
	<div class="w-44 shrink-0 sm:w-64">
		@input.Input(input.Props{
			Name: name, Value: value, Type: input.TypeSearch, Placeholder: placeholder,
			Class: "h-8 w-full",
			Attributes: templ.Attributes{
				"hx-get":       action,
				"hx-trigger":   "input changed delay:300ms, search",
				"hx-target":    target,
				"hx-select":    target,
				"hx-swap":      "outerHTML",
				"hx-indicator": target,
				"hx-push-url":  "true",
				"autocomplete": "off",
				"aria-label":   placeholder,
			},
		})
	</div>
}

// PageHeader is a page title + optional prose subtitle, with a right-aligned
// actions slot (children).
templ PageHeader(title, subtitle string) {
	@pageHeaderBody(title, subtitle, "text-sm text-muted-foreground") {
		{ children... }
	}
}

// PageHeaderCode is PageHeader where the subtitle is a machine string — a
// cache URL, a store path. Same header, mono subtitle: an address the reader
// may have to compare character by character is not prose.
templ PageHeaderCode(title, code string) {
	@pageHeaderBody(title, code, "break-all font-mono text-xs text-muted-foreground") {
		{ children... }
	}
}

templ pageHeaderBody(title, subtitle, subClass string) {
	<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
		<div class="min-w-0 space-y-1.5">
			<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
			if subtitle != "" {
				<p class={ subClass }>{ subtitle }</p>
			}
		</div>
		// The actions slot has to be able to grow: a w-full search box inside a
		// content-sized flex item resolves to zero, which left every search on
		// the site unreachable on a phone.
		<div class="flex min-w-0 flex-1 items-center justify-end gap-2 empty:hidden">
			{ children... }
		</div>
	</div>
}

// Crumb is one step of a Crumbs trail; the last item's Href is ignored.
type Crumb struct {
	Label, Href string
}

// Crumbs is the location trail above deep pages (cache, store path): every
// step but the last is a link back up.
templ Crumbs(items ...Crumb) {
	@breadcrumb.Breadcrumb(breadcrumb.Props{Class: "mb-4"}) {
		@breadcrumb.List() {
			for i, c := range items {
				@breadcrumb.Item() {
					if i > 0 {
						@breadcrumb.Separator()
					}
					if i == len(items)-1 {
						@breadcrumb.Page() {
							{ c.Label }
						}
					} else {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: c.Href}) {
							{ c.Label }
						}
					}
				}
			}
		}
	}
}

// CardHeaderRow is a card title with a right-aligned action (children).
templ CardHeaderRow(title string) {
	@card.Header(card.HeaderProps{Class: "flex-row items-center justify-between space-y-0"}) {
		@card.Title() {
			{ title }
		}
		{ children... }
	}
}

// ListBox is the in-card list shell: one bordered, rounded box around a
// table or divided rows. Not a nested card. Wide tables scroll sideways
// inside it instead of pushing the page.
templ ListBox() {
	<div class="divide-y overflow-x-auto rounded-lg border">
		{ children... }
	</div>
}

// TableCard is a table ruled off from the page — no card walls, because a
// list is not an object you act on as a whole. Sortable tables are table-fixed
// with sized meta columns, so below a floor the primary column would collapse
// to nothing: the floor makes the table scroll sideways instead.
templ TableCard() {
	<div class="overflow-x-auto border-y [&_table]:min-w-[48rem]">
		{ children... }
	</div>
}

// RowAction is the icon-only ghost button used in table rows and card
// corners: tooltip plus aria-label, one size everywhere. submit makes it a
// one-click form action; otherwise it is a plain button (dialog triggers).
templ RowAction(icon, label string, submit bool) {
	@WithTooltip(label) {
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Type: rowActionType(submit), Class: "size-8", Attributes: templ.Attributes{"aria-label": label}}) {
			@Icon(icon)
		}
	}
}

// PlusButton is the house create-trigger: small, outline, plus icon. It opens
// a form, it does not commit anything — the filled primary button is kept for
// the action that does, so primary stays worth noticing.
templ PlusButton(label string) {
	@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline}) {
		@Icon("plus")
		<span>{ label }</span>
	}
}

// DialogBox is a form dialog's body: title, one-line hint, then the form
// (children). wide picks the lg width used by multi-field forms.
templ DialogBox(title, hint string, wide bool) {
	@dialog.Content(dialog.ContentProps{Class: dialogWidth(wide)}) {
		@dialog.Header() {
			@dialog.Title() {
				{ title }
			}
			@dialog.Description() {
				{ hint }
			}
		}
		{ children... }
	}
}

// DialogFooter is the cancel + submit row every form dialog ends with.
templ DialogFooter(dlgID, icon, label string) {
	@dialog.Footer() {
		@dialog.Close(dialog.CloseProps{For: dlgID}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
				{ T(ctx, "action.cancel") }
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			@Icon(icon)
			<span>{ label }</span>
		}
	}
}

// ActionRow is a sentence with its action on the right: "Rotate the key" +
// button, "Protect your account" + Enable. Wraps on narrow screens.
templ ActionRow(text string) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<p class="text-sm text-muted-foreground">{ text }</p>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// SettingsCard is the other half of the card rule: a card encloses something
// you submit or copy. Title, optional one-line hint, then the form. Every
// settings panel is one of these — the header/description/content triple was
// hand-written a dozen times and drifted in spacing each time.
templ SettingsCard(title, hint string) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ title }
			}
			if hint != "" {
				@card.Description() {
					{ hint }
				}
			}
		}
		@card.Content(card.ContentProps{Class: "space-y-4"}) {
			{ children... }
		}
	}
}

// ListSection is the house shape for "a titled list with a create button":
// heading row, optional action, then the rows. Every list on the settings,
// organization and dashboard pages is one of these, so the spacing and the
// heading weight cannot drift between them. Pass nil for actions when the
// section has none.
templ ListSection(title string, actions templ.Component) {
	<div>
		@SectionHeader(title) {
			if actions != nil {
				@actions
			}
		}
		{ children... }
	</div>
}

// RowActions is the right-aligned cluster of RowAction buttons that closes a
// list row.
templ RowActions() {
	<div class="flex justify-end gap-1">
		{ children... }
	</div>
}

// Meta is the secondary fact riding beside a name in a list row — a plan's
// limits, an organization's usage. Mono because it is always quantities.
templ Meta() {
	<span class="min-w-0 truncate font-mono text-xs text-muted-foreground tabular-nums">
		{ children... }
	</span>
}

// Readout is one value-and-label pair on a single line: the compact form of
// StatTile, for strips where the label sits beside the number rather than
// under it. Same rule — value in mono, label in prose.
templ Readout(value, label, id, tone string) {
	<div class="flex items-baseline gap-2">
		<span
			class={ "font-mono text-sm tabular-nums", tone }
			if id != "" {
				id={ id }
			}
		>{ value }</span>
		<span class="text-xs text-muted-foreground">{ label }</span>
	</div>
}

// SectionHeader is a lighter heading for a card/region, with an actions slot.
templ SectionHeader(title string) {
	<div class="mb-3 flex flex-wrap items-end justify-between gap-3">
		<h2 class="text-base font-semibold tracking-tight">{ title }</h2>
		// Same growable actions slot as the page header, for the same reason.
		<div class="flex min-w-0 flex-1 items-center justify-end gap-2 empty:hidden">
			{ children... }
		</div>
	</div>
}

// StatTile is one readout: the value in mono tabular figures over its label.
// Machine truth is monospace here and everywhere — these numbers are read in
// columns and compared, not admired. A non-empty id marks the value for live
// updates; tone adds a text color class to it.
templ StatTile(icon, value, label, id, tone string) {
	<div class="w-[calc(50%-1.5rem)] min-w-0 py-0.5 sm:w-32">
		<div
			class={ "truncate font-mono text-[1.6rem] font-medium leading-tight tracking-tight tabular-nums", tone }
			if id != "" {
				id={ id }
			}
		>{ value }</div>
		<div class="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
			<span class="shrink-0 opacity-60">
				@IconClass(icon, 12, "")
			</span>
			<span class="truncate">{ label }</span>
		</div>
	</div>
}

// StatRow is the readout strip a page opens with: tiles ruled off from the
// page above and below, no boxes.
//
// A wrapping row of fixed-width tiles rather than a grid of equal fractions:
// with a grid, three readouts spread themselves across the full width and the
// numbers stop reading as a group. Fixed columns keep the strip identical
// whether a page has three of them or twelve, and wrap on a phone.
templ StatRow() {
	<div class="mb-8 flex flex-wrap gap-x-12 gap-y-5 border-y py-4">
		{ children... }
	</div>
}

// DedupBar draws the one thing this whole product exists to do: the same
// bytes stored once. The full bar is what was pushed; the solid part is what
// is actually on disk, the rest is what deduplication saved. Ratio, both
// quantities and their relationship in a single figure — so it is the loudest
// element on the page, and every other number around it can stay quiet.
templ DedupBar(logical, physical int64, ratio string, bytes func(int64) string) {
	// Nothing stored yet has no dedup story: "1.00×" over a bar that is
	// entirely "saved" claims a win for an empty cache. Say nothing instead.
	if logical > 0 {
		<div class="mb-8">
		<div class="flex items-end justify-between gap-6">
			<div>
				<div class="font-mono text-5xl font-medium leading-none tracking-tighter tabular-nums text-brand">{ ratio }×</div>
				<div class="mt-2 text-xs text-muted-foreground">{ T(ctx, "kpi.dedup") }</div>
			</div>
			<div class="text-right">
				<div class="font-mono text-sm tabular-nums">{ bytes(logical) }</div>
				<div class="text-xs text-muted-foreground">{ T(ctx, "kpi.logical") }</div>
			</div>
		</div>
		@progress.Progress(progress.Props{
			Value:    fillPct(physical, logical),
			Class:    "mt-3 [&>div]:rounded-none [&>div]:bg-primary",
			BarClass: "rounded-none bg-foreground/85",
		})
		<div class="mt-1.5 flex justify-between gap-4 text-xs">
			<span class="min-w-0 truncate">
				<span class="font-mono tabular-nums">{ bytes(physical) }</span>
				<span class="text-muted-foreground">{ " " + T(ctx, "kpi.physical") }</span>
			</span>
			<span class="min-w-0 truncate">
				<span class="font-mono tabular-nums text-brand">{ bytes(savedBytes(logical, physical)) }</span>
				<span class="text-muted-foreground">{ " " + T(ctx, "kpi.saved") }</span>
			</span>
			</div>
		</div>
	}
}

// StoreHash sets a store-path hash the way people read one: the leading
// characters at full contrast — the part anyone actually matches on — and the
// tail dimmed. The hash is the identity of everything in a Nix store; it gets
// to look like it.
templ StoreHash(hash string) {
	<span class="font-mono text-xs tracking-tight">
		<span class="text-foreground/70">{ hashHead(hash) }</span><span class="text-muted-foreground/50">{ hashTail(hash) }</span>
	</span>
}

// EmptyLine is the empty state for a list that already sits inside a card:
// one muted line where the rows would be. The full EmptyState — icon, rules,
// generous padding — is framing, and a panel that is already framed does not
// need a second frame around the words "None yet."
templ EmptyLine(msg string) {
	<p class="py-2 text-sm text-muted-foreground">{ msg }</p>
}

// EmptyState is the shared empty-list block: icon, message, optional action.
templ EmptyState(icon, msg string) {
	<div class="flex flex-col items-center gap-3 border-y px-6 py-10 text-center">
		<span class="text-muted-foreground/40">
			@IconClass(icon, 24, "")
		</span>
		<p class="text-sm text-muted-foreground">{ msg }</p>
		<div class="flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

// PagerNav renders prev/next controls; nothing when there is a single page.
templ PagerNav(p Pager) {
	if p.Pages > 1 {
		@pagination.Pagination(pagination.Props{Class: "mt-4"}) {
			@pagination.Content() {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{Href: p.Prev, Disabled: p.Prev == "", Label: T(ctx, "pager.prev"), Attributes: hxSwapAttrs(p.Prev, p.Target)})
				}
				@pagination.Item() {
					<span class="px-2 text-sm text-muted-foreground tabular-nums">{ itoa(int64(p.Page)) } / { itoa(int64(p.Pages)) }</span>
				}
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{Href: p.Next, Disabled: p.Next == "", Label: T(ctx, "pager.next"), Attributes: hxSwapAttrs(p.Next, p.Target)})
				}
			}
		}
	}
}

// SortHead is a clickable, direction-indicating table header cell; class sets
// a stable column width (tables render with table-fixed).
templ SortHead(s SortCtx, key, label, class string) {
	@table.Head(table.HeadProps{Class: class}) {
		<a
			class="inline-flex items-center gap-1 hover:text-foreground"
			href={ templ.SafeURL(s.URL(key)) }
			aria-sort={ ariaSort(s, key) }
			{ hxSwapAttrs(s.URL(key), s.Target)... }
		>
			<span>{ label }</span>
			if s.Key == key {
				if s.Dir == "asc" {
					@IconClass("chevron-up", 12, "")
				} else {
					@IconClass("chevron-down", 12, "")
				}
			}
		</a>
	}
}

// Confirm parameterizes a confirm-before-POST action: an inline trigger button
// that opens a dialog; confirming submits `Action`. Extra hidden inputs go in
// the children slot.
type Confirm struct {
	ID             string
	Action         string
	Title          string
	Message        string
	ConfirmLabel   string
	ConfirmIcon    string
	Danger         bool
	TriggerLabel   string
	TriggerIcon    string
	TriggerVariant button.Variant
	IconOnly       bool
	TriggerTooltip string
}

templ ConfirmForm(c Confirm) {
	@dialog.Dialog(dialog.Props{ID: c.ID}) {
		@dialog.Trigger(dialog.TriggerProps{For: c.ID}) {
			if c.IconOnly && c.TriggerTooltip != "" {
				@WithTooltip(c.TriggerTooltip) {
					@confirmTriggerButton(c)
				}
			} else {
				@confirmTriggerButton(c)
			}
		}
		@DialogBox(c.Title, c.Message, false) {
			<form method="post" action={ templ.SafeURL(c.Action) } class="mt-2">
				{ children... }
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: c.ID}) {
						@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
							{ T(ctx, "action.cancel") }
						}
					}
					@button.Button(button.Props{Variant: confirmVariant(c.Danger), Type: button.TypeSubmit}) {
						if c.ConfirmIcon != "" {
							@Icon(c.ConfirmIcon)
						}
						<span>{ c.ConfirmLabel }</span>
					}
				}
			</form>
		}
	}
}

// confirmTriggerButton is the inline trigger button for a Confirm.
templ confirmTriggerButton(c Confirm) {
	@button.Button(confirmTriggerProps(c)) {
		@Icon(c.TriggerIcon)
		if !c.IconOnly {
			<span>{ c.TriggerLabel }</span>
		}
	}
}

// RoleIcon is a person's role as one glyph with the role name in a tooltip
// and aria-label: superadmin / owner / admin / user / pending.
templ RoleIcon(role string) {
	@WithTooltip(T(ctx, "role." + role)) {
		<span class={ "inline-flex", roleTone(role) } role="img" aria-label={ T(ctx, "role." + role) }>
			@Icon(roleIcon(role))
		</span>
	}
}

// StatusIcon renders a token's status as one glyph (check, clock, ban); the
// word rides in the tooltip and the aria-label.
templ StatusIcon(status string) {
	@WithTooltip(T(ctx, "tok." + status)) {
		<span class={ "inline-flex", statusTone(status) } role="img" aria-label={ T(ctx, "tok." + status) }>
			@Icon(statusIcon(status))
		</span>
	}
}

// VisBadge shows a cache's public/private state. One weight for both: a
// filled badge beside an outline one reads as two kinds of thing, when these
// are two values of the same fact. The glyph and the word carry the
// difference, and lowercase is a badge's own house style — the label case is
// set here, not in six catalogs.
templ VisBadge(public bool) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "gap-1 lowercase"}) {
		if public {
			@Icon("globe")
			<span>{ T(ctx, "vis.public") }</span>
		} else {
			@Icon("lock")
			<span>{ T(ctx, "vis.private") }</span>
		}
	}
}

// PermBadges renders a token's permissions as small labelled badges.
templ PermBadges(perms []string) {
	<div class="flex flex-wrap gap-1">
		for _, p := range perms {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ T(ctx, "perm." + p) }
			}
		}
	</div>
}

// SettingRow is one line of a settings list: what the setting is, what it
// currently says, and the control that changes it. Label in prose, value in
// machine truth (an address, a state), action on the right. Every credential
// row on the account page is one of these, so the heights cannot drift.
templ SettingRow(label, value string) {
	<div class="flex flex-wrap items-center justify-between gap-3 py-3">
		<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
			<p class="text-sm font-medium">{ label }</p>
			if value != "" {
				<span class="min-w-0 truncate font-mono text-xs text-muted-foreground">{ value }</span>
			}
		</div>
		<div class="flex shrink-0 items-center gap-2">
			{ children... }
		</div>
	</div>
}
