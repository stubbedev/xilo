package views

import (
	"strconv"

	"github.com/stubbedev/xilo/internal/store"

	"github.com/templui/templui/components/form"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/switch"
)

// Field is a labelled form control built on the templui form component:
// form.Item groups the form.Label with the control (children). An empty id
// means the text heads a group of controls (no `for`); the same label element
// is used either way so labels line up across a grid of fields.
templ Field(id, text string) {
	@form.Item() {
		if text != "" {
			@fieldLabel(id, text, "")
		}
		{ children... }
	}
}

// FieldInfo is a Field whose explanation sits in an info glyph next to the
// label (tooltip), not in a line under the control, so a row of fields keeps
// one height.
templ FieldInfo(id, text, hint string) {
	@form.Item() {
		@fieldLabel(id, text, hint)
		{ children... }
	}
}

// fieldLabel is the label row shared by Field and FieldInfo.
templ fieldLabel(id, text, hint string) {
	<div class="flex items-center gap-1.5">
		@form.Label(form.LabelProps{For: id}) {
			{ text }
		}
		if hint != "" {
			@WithTooltip(hint) {
				<span class="inline-flex text-muted-foreground" tabindex="0" aria-label={ hint }>
					@Icon("info")
				</span>
			}
		}
	</div>
}

// AccountSelect is a namespace picker.
templ AccountSelect(name, value, placeholder string, accounts []store.Account) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: placeholder})
		}
		@selectbox.Content() {
			for _, a := range accounts {
				@selectbox.Item(selectbox.ItemProps{Value: a.Slug, Selected: a.Slug == value}) {
					{ a.Slug }
				}
			}
		}
	}
}

// ScopeSelect chooses the single cache a token is valid for.
templ ScopeSelect(name, value string, caches []CacheUsage) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: T("tokens.pickcache")})
		}
		@selectbox.Content() {
			for _, u := range caches {
				@selectbox.Item(selectbox.ItemProps{Value: u.Cache.Ref(), Selected: u.Cache.Ref() == value}) {
					{ u.Cache.Ref() }
				}
			}
		}
	}
}

// StorageSelect chooses a blob backend by name.
templ StorageSelect(name, value string, storages []string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: T("storage.default")})
		}
		@selectbox.Content() {
			for _, s := range storages {
				@selectbox.Item(selectbox.ItemProps{Value: s, Selected: s == value}) {
					{ s }
				}
			}
		}
	}
}

// ttlPresets are the expiry choices offered for tokens, in seconds.
var ttlPresets = []struct {
	Secs  int64
	Label string
}{
	{7 * 86400, "ttl.7d"},
	{30 * 86400, "ttl.30d"},
	{90 * 86400, "ttl.90d"},
	{365 * 86400, "ttl.1y"},
}

// TTLSelect picks a token expiry from preset durations. On create 30 days is
// preselected; on edit nothing is, and the empty value keeps the stored
// expiry (the handler's empty-keeps-current contract).
templ TTLSelect(t *store.Token) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "ttl"}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: T("ttl.keep")})
		}
		@selectbox.Content() {
			for _, p := range ttlPresets {
				@selectbox.Item(selectbox.ItemProps{Value: strconv.FormatInt(p.Secs, 10), Selected: t == nil && p.Secs == 30*86400}) {
					{ T(p.Label) }
				}
			}
		}
	}
}

// DurationInput is a number + unit (hours/days/months/years) pair backed by
// "<name>_value" and "<name>_unit" fields.
templ DurationInput(name string, secs int64) {
	<div class="flex gap-2">
		@input.Input(input.Props{
			Name: name + "_value", Type: input.TypeNumber, Value: durValue(secs),
			Class: "min-w-0 flex-1", Attributes: templ.Attributes{"min": "0", "step": "1", "aria-label": T("unit.duration")},
		})
		<div class="w-28 shrink-0">
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{Name: name + "_unit"}) {
					@selectbox.Value(selectbox.ValueProps{})
				}
				@selectbox.Content() {
					@unitItem(name, "h", T("unit.hours"), secs)
					@unitItem(name, "d", T("unit.days"), secs)
					@unitItem(name, "mo", T("unit.months"), secs)
					@unitItem(name, "y", T("unit.years"), secs)
				}
			}
		</div>
	</div>
}

templ unitItem(name, unit, label string, secs int64) {
	@selectbox.Item(selectbox.ItemProps{Value: unit, Selected: durUnit(secs) == unit}) {
		{ label }
	}
}

// SizeInput is a number + binary unit (MiB/GiB/TiB) pair backed by
// "<name>_value" and "<name>_unit".
templ SizeInput(name string, bytes int64) {
	<div class="flex gap-2">
		@input.Input(input.Props{
			Name: name + "_value", Type: input.TypeNumber, Value: sizeValue(bytes),
			Class: "min-w-0 flex-1", Placeholder: T("unit.unlimited"), Attributes: templ.Attributes{"min": "0", "step": "1", "aria-label": T("paths.size")},
		})
		<div class="w-28 shrink-0">
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{Name: name + "_unit"}) {
					@selectbox.Value(selectbox.ValueProps{})
				}
				@selectbox.Content() {
					@sizeUnitItem(name, "MiB", T("unit.mib"), bytes)
					@sizeUnitItem(name, "GiB", T("unit.gib"), bytes)
					@sizeUnitItem(name, "TiB", T("unit.tib"), bytes)
				}
			}
		</div>
	</div>
}

templ sizeUnitItem(name, unit, label string, bytes int64) {
	@selectbox.Item(selectbox.ItemProps{Value: unit, Selected: sizeUnit(bytes) == unit}) {
		{ label }
	}
}

// PriorityField is the 1–100 substituter-priority number input.
templ PriorityField(value int) {
	@FieldInfo("priority", T("caches.priority"), T("caches.priorityhint")) {
		@input.Input(input.Props{
			ID: "priority", Name: "priority", Type: input.TypeNumber, Value: strconv.Itoa(value),
			Attributes: templ.Attributes{"min": "1", "max": "100"},
		})
	}
}

// VisibilitySwitch toggles a cache's privacy; checked = private.
templ VisibilitySwitch(private bool) {
	@form.ItemFlex(form.ItemProps{Class: "justify-between rounded-lg border p-3"}) {
		@form.Item(form.ItemProps{Class: "space-y-0.5"}) {
			@form.Label() {
				{ T("vis.private") }
			}
			@form.Description() {
				{ T("caches.privatehint") }
			}
		}
		@switchcomp.Switch(switchcomp.Props{Name: "private", Value: "on", Checked: private})
	}
}

// PermSwitchID is a labelled switch row with an explicit DOM id — required
// when the same form body renders more than once per page (per-row dialogs).
templ PermSwitchID(id, name, value, text string, checked bool) {
	@form.ItemFlex(form.ItemProps{Class: "justify-between rounded-lg border p-3"}) {
		@form.Label(form.LabelProps{For: id}) {
			{ text }
		}
		@switchcomp.Switch(switchcomp.Props{ID: id, Name: name, Value: value, Checked: checked})
	}
}

// ExpiryField is the token expiry control: a "never" switch that hides the
// TTL presets while on. t is nil on create.
templ ExpiryField(dlgID string, t *store.Token) {
	@Field("", T("tokens.expiry")) {
		<div class="group/expiry space-y-2">
			@PermSwitchID(dlgID+"-permanent", "permanent", "on", T("tokens.permanent"), tokenPermanent(t))
			<div class="group-has-[:checked]/expiry:hidden">
				@TTLSelect(t)
			</div>
		</div>
	}
}
